'use client';

import { useState, useCallback } from 'react';
import { Receipt, Search, Eye } from 'lucide-react';
import { useEscapeClose } from '@/lib/hooks/use-escape-close';
import type { Gasto } from '@/lib/types/gasto';
import DigitalInvoice from './digital-invoice';

/**
 * @name GastosEmpresaClient
 * @description [Business View]: Renders the corporate expense table showing
 * all receipts justified via WhatsApp that were paid with company funds
 * (corporate cards, travel advances). Each row can open a DigitalInvoice modal.
 */
export default function GastosEmpresaClient({ gastos }: { gastos: Gasto[] }) {
  const [search, setSearch] = useState('');
  const [selectedGasto, setSelectedGasto] = useState<Gasto | null>(null);

  const handleCloseModal = useCallback(() => setSelectedGasto(null), []);

  useEscapeClose(handleCloseModal, selectedGasto !== null);

  const filtered = gastos.filter((g) =>
    g.empleado.toLowerCase().includes(search.toLowerCase()) ||
    g.comercio.toLowerCase().includes(search.toLowerCase()) ||
    g.proyecto.toLowerCase().includes(search.toLowerCase())
  );

  return (
    <>
      <div className="page-header">
        <h1 className="page-title"><Receipt size={24} strokeWidth={2} />Gastos de Empresa</h1>
        <p className="page-subtitle">Comprobantes justificados pagados con fondos corporativos (Tarjetas de crédito/débito de la empresa).</p>
      </div>

      <div style={{ position: 'relative', marginBottom: '20px' }}>
        <Search size={15} style={{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)', color: 'var(--text-muted)', pointerEvents: 'none' }} />
        <input
          id="gastos-search"
          type="search"
          placeholder="Buscar por empleado, comercio o proyecto…"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          style={{ width: '100%', background: 'var(--bg-surface)', border: '1px solid var(--bg-border)', borderRadius: '8px', padding: '9px 12px 9px 36px', color: 'var(--text-primary)', fontSize: '13px', outline: 'none' }}
        />
      </div>

      <div className="card">
        {gastos.length === 0 ? (
          <div className="empty-state">
            <div className="empty-state-icon"><Receipt size={22} /></div>
            <div className="empty-state-title">Sin gastos corporativos registrados</div>
            <div className="empty-state-desc">Los gastos registrados con tarjetas o fondos de la empresa aparecerán aquí.</div>
          </div>
        ) : (
          <div style={{ overflowX: 'auto', WebkitOverflowScrolling: 'touch' }}>
            <table className="rendy-table">
              <thead>
                <tr>
                  <th>Empleado</th>
                  <th>Categoría</th>
                  <th>Comercio</th>
                  <th>Monto</th>
                  <th>Tasa</th>
                  <th>Convertido</th>
                  <th>Proyecto</th>
                  <th>Fecha</th>
                  <th>Método</th>
                  <th style={{ textAlign: 'right' }}>Comprobante</th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((g) => {
                  const tieneTasa = g.tasa_cambio && g.tasa_cambio !== 1;
                  const monedaViat = g.moneda_viatico || 'USD';

                  return (
                    <tr key={g.id}>
                      <td style={{ verticalAlign: 'middle', fontWeight: 600, color: 'var(--text-primary)' }}>{g.empleado}</td>
                      <td style={{ verticalAlign: 'middle' }}>
                        <span style={{ background: 'var(--bg-elevated)', padding: '2px 8px', borderRadius: '6px', fontSize: '11px', fontWeight: 600, color: 'var(--text-accent)' }}>
                          {g.categoria}
                        </span>
                      </td>
                      <td style={{ verticalAlign: 'middle' }}>{g.comercio}</td>
                      
                      {/* Monto Original */}
                      <td style={{ verticalAlign: 'middle', fontWeight: 700, color: 'var(--text-primary)' }}>
                        {g.monto.toLocaleString('es-VE', { minimumFractionDigits: 2 })} {g.moneda}
                      </td>

                      {/* Tasa de Cambio */}
                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>
                        {tieneTasa ? `${g.tasa_cambio}` : '1.00'}
                      </td>

                      {/* Monto Convertido / Deducible */}
                      <td style={{ verticalAlign: 'middle', fontWeight: 700, color: tieneTasa ? '#10b981' : 'var(--text-primary)' }}>
                        {g.monto_convertido != null && tieneTasa
                          ? `${g.monto_convertido.toLocaleString('es-VE', { minimumFractionDigits: 2 })} ${monedaViat}`
                          : `${g.monto.toLocaleString('es-VE', { minimumFractionDigits: 2 })} ${g.moneda}`}
                      </td>

                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>{g.proyecto}</td>
                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>{g.fecha_gasto}</td>
                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>{g.metodo_pago}</td>
                      <td style={{ verticalAlign: 'middle', textAlign: 'right' }}>
                        <button
                          onClick={() => setSelectedGasto(g)}
                          className="btn btn-ghost btn-sm"
                          style={{
                            background: 'rgba(99, 102, 241, 0.1)',
                            border: '1px solid rgba(99, 102, 241, 0.25)',
                            color: 'var(--rendy-primary-light)',
                            gap: '5px',
                            cursor: 'pointer',
                          }}
                        >
                          <Eye size={12} /> Ver
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* ── Digital Invoice Modal ── */}
      {selectedGasto && (
        <DigitalInvoice
          gasto={selectedGasto}
          onClose={handleCloseModal}
        />
      )}
    </>
  );
}
</file>

<file path="app/dashboard/reembolsos/page.tsx">
/**
 * @name ReembolsosPage
 * @description [Server Component]: Main server-side page for corporate reimbursement tracking
 * and settlement (/dashboard/reembolsos). Reads URL searchParams as the single source of truth,
 * fetches paginated expenses and aggregated KPIs, and coordinates client filtering and mutations.
 */

import React from 'react';
import { RotateCcw } from 'lucide-react';
import { requireAuthenticatedSession } from '@/lib/auth/session-context';
import {
  obtenerReembolsosPaginados,
  obtenerKpisReembolsos,
  obtenerEmpleadosEmpresa,
  type EstadoReembolso,
} from '@/lib/services/reembolsos.service';
import { ReembolsosStatsCards } from './_components/ReembolsosStatsCards';
import { ReembolsosFilters } from './_components/ReembolsosFilters';
import { ReembolsosTable } from './_components/ReembolsosTable';

interface PageProps {
  searchParams: Promise<{
    empleado?: string;
    estado?: string;
    desde?: string;
    hasta?: string;
    busqueda?: string;
    page?: string;
  }>;
}

export const dynamic = 'force-dynamic';

export default async function ReembolsosPage({ searchParams }: PageProps) {
  const session = await requireAuthenticatedSession();
  const isEmployee = session.role === 'EMPLOYEE';
  const params = await searchParams;

  const validEstados: Set<string> = new Set([
    'PENDIENTE',
    'PROCESADO',
    'TRANSFERIDO',
    'RECHAZADO',
    'TODOS',
  ]);

  const estadoParsed =
    params.estado && validEstados.has(params.estado)
      ? (params.estado as EstadoReembolso | 'TODOS')
      : 'TODOS';

  const filtros = {
    empleadoId: isEmployee ? session.userId : params.empleado || undefined,
    estado: estadoParsed,
    fechaDesde: params.desde || undefined,
    fechaHasta: params.hasta || undefined,
    busqueda: params.busqueda || undefined,
    page: params.page ? parseInt(params.page, 10) : 1,
    pageSize: 15,
  };

  // Parallel server fetch for optimal performance
  const [paginatedData, kpis, empleados] = await Promise.all([
    obtenerReembolsosPaginados(session.empresaId, filtros),
    obtenerKpisReembolsos(session.empresaId),
    obtenerEmpleadosEmpresa(session.empresaId),
  ]);

  const { reembolsos, totalCount, totalPages, currentPage, pageSize } = paginatedData;

  return (
    <div style={{ display: 'flex', flexDirection: 'column', gap: '22px', width: '100%' }}>
      {/* Page Header */}
      <div className="page-header" style={{ marginBottom: 0 }}>
        <h1 className="page-title" style={{ display: 'flex', alignItems: 'center', gap: '10px' }}>
          <RotateCcw size={24} strokeWidth={2.2} style={{ color: 'var(--rendy-primary)' }} />
          Liquidación de Reembolsos
        </h1>
        <p className="page-subtitle">
          Supervisa, aprueba y audita los pagos adeudados a empleados por gastos cubiertos con fondos personales.
        </p>
      </div>

      {/* KPI Cards */}
      <ReembolsosStatsCards kpis={kpis} />

      {/* Filters (URL-Driven with 300ms Debounce) */}
      <ReembolsosFilters empleados={empleados} />

      {/* Paginated Data Table with Actions & eReceipt Modal */}
      <ReembolsosTable
        data={reembolsos}
        totalCount={totalCount}
        totalPages={totalPages}
        currentPage={currentPage}
        pageSize={pageSize}
      />
    </div>
  );
}
</file>

<file path="app/dashboard/solicitudes/actions.ts">
'use server';

/**
 * @name SolicitudesViaticosServerActions
 * @description [Business Logic]: Server Actions managing corporate travel allowance
 * approval lifecycle, bank transfer proof storage uploads (images/PDFs), and automated
 * WhatsApp notifications dispatch to employees.
 */

import { revalidatePath } from 'next/cache';
import { supabaseServer, EMPRESA_ID } from '@/lib/supabase-server';
import { enviarMensajeWhatsApp, enviarArchivoWhatsApp } from '@/app/lib/whatsapp';

export interface SolicitudActionResult {
  success: boolean;
  error?: string | null;
  url?: string | null;
}

const MAX_FILE_SIZE_BYTES = 5 * 1024 * 1024; // 5 MB
const ALLOWED_MIME_TYPES = [
  'image/jpeg',
  'image/png',
  'image/webp',
  'image/jpg',
  'application/pdf',
];

/**
 * @name uploadComprobanteTransferenciaStorage
 * @description [Storage]: Helper that uploads a bank transfer proof image or PDF to
 * Supabase Storage bucket 'comprobantes_transferencias' (with defensive fallback to
 * 'comprobantes_pago' if bucket is unavailable).
 */
async function uploadComprobanteTransferenciaStorage(
  file: File,
  solicitudId: string
): Promise<{ url: string | null; error: string | null }> {
  try {
    if (file.size > MAX_FILE_SIZE_BYTES) {
      return { url: null, error: 'El archivo excede el tamaño máximo permitido de 5MB.' };
    }

    if (!ALLOWED_MIME_TYPES.includes(file.type)) {
      return {
        url: null,
        error: 'Formato no permitido. Solo se aceptan imágenes (JPG, PNG, WEBP) o documentos PDF.',
      };
    }

    const arrayBuffer = await file.arrayBuffer();
    const buffer = Buffer.from(arrayBuffer);
    const extension = file.name.split('.').pop() || (file.type === 'application/pdf' ? 'pdf' : 'jpg');
    const fileName = `viatico_transferencia_${Date.now()}_${solicitudId.substring(0, 8)}.${extension}`;

    // Attempt upload to primary bucket 'comprobantes_transferencias'
    let bucketName = 'comprobantes_transferencias';
    let { error: uploadError } = await supabaseServer.storage
      .from(bucketName)
      .upload(fileName, buffer, {
        contentType: file.type,
        upsert: true,
      });

    // Fallback to 'comprobantes_pago' if primary bucket is not provisioned
    if (uploadError) {
      console.warn('⚠️ [Storage] Could not upload to comprobantes_transferencias, falling back to comprobantes_pago:', uploadError.message);
      bucketName = 'comprobantes_pago';
      const fallbackUpload = await supabaseServer.storage
        .from(bucketName)
        .upload(fileName, buffer, {
          contentType: file.type,
          upsert: true,
        });

      if (fallbackUpload.error) {
        console.error('❌ [Storage] Fallback upload also failed:', fallbackUpload.error);
        return { url: null, error: `Error al subir el archivo: ${fallbackUpload.error.message}` };
      }
    }

    const { data: urlData } = supabaseServer.storage
      .from(bucketName)
      .getPublicUrl(fileName);

    return { url: urlData.publicUrl, error: null };
  } catch (err) {
    const msg = err instanceof Error ? err.message : 'Error al procesar el archivo';
    console.error('❌ [uploadComprobanteTransferenciaStorage] Exception:', err);
    return { url: null, error: msg };
  }
}

/**
 * @name aprobarSolicitudConComprobanteAction
 * @description [Business Logic]: Approves a travel allowance request, optionally attaching
 * bank transfer proof, reference number, and disbursement notes. Dispatches WhatsApp notification
 * with the bank transfer receipt attached if provided.
 */
export async function aprobarSolicitudConComprobanteAction(
  formData: FormData
): Promise<SolicitudActionResult> {
  try {
    const solicitudId = formData.get('solicitudId') as string;
    const file = formData.get('file') as File | null;
    const referenciaTransferencia = (formData.get('referenciaTransferencia') as string | null)?.trim() || null;
    const notasDesembolso = (formData.get('notasDesembolso') as string | null)?.trim() || null;

    if (!solicitudId) {
      return { success: false, error: 'Identificador de solicitud inválido.' };
    }

    // 1. Fetch solicitud details with joined user and project
    const { data: sol, error: fetchErr } = await supabaseServer
      .from('solicitudes_viaticos')
      .select('id, monto_solicitado, moneda, usuario_id, empresa_id, proyecto_id, proyectos(nombre), usuarios(telefono_whatsapp, nombre)')
      .eq('id', solicitudId)
      .single();

    if (fetchErr || !sol) {
      return { success: false, error: 'No se pudo encontrar la solicitud de viáticos.' };
    }

    // 2. Upload file if provided
    let urlComprobanteTransferencia: string | null = null;
    const hasFile = file && file.size > 0;
    if (hasFile) {
      const uploadResult = await uploadComprobanteTransferenciaStorage(file, solicitudId);
      if (uploadResult.error) {
        return { success: false, error: uploadResult.error };
      }
      urlComprobanteTransferencia = uploadResult.url;
    }

    // 3. Update solicitudes_viaticos record
    const nowIso = new Date().toISOString();
    const updatePayload: Record<string, unknown> = {
      estado: 'APROBADO',
      monto_aprobado: sol.monto_solicitado,
    };

    if (urlComprobanteTransferencia) {
      updatePayload.url_comprobante_transferencia = urlComprobanteTransferencia;
      updatePayload.referencia_transferencia = referenciaTransferencia;
      updatePayload.notas_desembolso = notasDesembolso;
      updatePayload.fecha_transferencia = nowIso;
    }

    let { error: updateError } = await supabaseServer
      .from('solicitudes_viaticos')
      .update(updatePayload)
      .eq('id', solicitudId);

    // Defensive fallback: if migration 013 is not yet applied, retry without new columns
    if (updateError && updateError.code === '42703') {
      console.warn('⚠️ [aprobarSolicitud] Transfer columns not in table yet (Migration 013 pending). Retrying without transfer audit columns...');
      const fallbackPayload = {
        estado: 'APROBADO',
        monto_aprobado: sol.monto_solicitado,
      };
      const retryResult = await supabaseServer
        .from('solicitudes_viaticos')
        .update(fallbackPayload)
        .eq('id', solicitudId);

      updateError = retryResult.error;
    }

    if (updateError) {
      console.error('❌ [aprobarSolicitud] Error updating solicitudes_viaticos:', updateError);
      return { success: false, error: updateError.message };
    }

    // 4. Synchronize into viaticos table for viaticosEngine
    const rawProyecto = (Array.isArray(sol.proyectos) ? sol.proyectos[0] : sol.proyectos) as
      | { nombre?: string }
      | null
      | undefined;
    const proyectoNombre = rawProyecto?.nombre || 'General';
    const viaticosPayload: Record<string, unknown> = {
      id: solicitudId,
      empleado_id: sol.usuario_id,
      empresa_id: sol.empresa_id || EMPRESA_ID,
      proyecto_id: sol.proyecto_id,
      nombre_proyecto: proyectoNombre,
      monto_asignado_usd: Number(sol.monto_solicitado || 0),
      estado: 'ACTIVO',
      actualizado_en: nowIso,
    };

    if (urlComprobanteTransferencia) {
      viaticosPayload.url_comprobante_transferencia = urlComprobanteTransferencia;
      viaticosPayload.referencia_transferencia = referenciaTransferencia;
      viaticosPayload.notas_desembolso = notasDesembolso;
      viaticosPayload.fecha_transferencia = nowIso;
    }

    let { error: viatErr } = await supabaseServer.from('viaticos').upsert(viaticosPayload);
    if (viatErr && viatErr.code === '42703') {
      // Retry without transfer columns if viaticos table doesn't have them yet
      delete viaticosPayload.url_comprobante_transferencia;
      delete viaticosPayload.referencia_transferencia;
      delete viaticosPayload.notas_desembolso;
      delete viaticosPayload.fecha_transferencia;
      await supabaseServer.from('viaticos').upsert(viaticosPayload);
    }

    // 5. Notify employee via WhatsApp
    const rawUsuario = (Array.isArray(sol.usuarios) ? sol.usuarios[0] : sol.usuarios) as
      | { telefono_whatsapp?: string; nombre?: string }
      | null
      | undefined;
    const telefono = rawUsuario?.telefono_whatsapp;

    if (telefono) {
      const monedaStr = sol.moneda || 'USD';
      const montoFormateado = Number(sol.monto_solicitado || 0).toLocaleString('es-VE', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });

      const refTexto = referenciaTransferencia ? `\n🔢 *Referencia:* ${referenciaTransferencia}` : '';
      const notaTexto = notasDesembolso ? `\n📝 *Nota:* ${notasDesembolso}` : '';

      if (urlComprobanteTransferencia) {
        const caption =
          `✅ *¡Viático Aprobado y Transferido!*\n\n` +
          `📌 *Proyecto:* ${proyectoNombre}\n` +
          `💵 *Monto Desembolsado:* ${montoFormateado} ${monedaStr}` +
          `${refTexto}${notaTexto}\n\n` +
          `Adjunto encontrarás el comprobante bancario de la transferencia. Ya puedes rendir tus gastos enviando fotos de tus comprobantes por aquí.`;

        const isPdf = /\.(pdf)$/i.test(urlComprobanteTransferencia.split('?')[0]);
        const filename = isPdf ? 'Comprobante_Transferencia.pdf' : 'Comprobante_Transferencia.jpg';

        await enviarArchivoWhatsApp(telefono, urlComprobanteTransferencia, caption, filename);
      } else {
        const mensajeWA =
          `✅ *¡SOLICITUD DE VIÁTICOS APROBADA!*\n\n` +
          `📌 *Solicitud #:* ${solicitudId.slice(0, 8)}…\n` +
          `📁 *Proyecto:* ${proyectoNombre}\n` +
          `💵 *Monto Aprobado:* ${montoFormateado} ${monedaStr}\n\n` +
          `_Los fondos han sido autorizados por la administración y estarán disponibles a la brevedad._`;

        await enviarMensajeWhatsApp(telefono, mensajeWA);
      }

      // Proactively send US Tax-Exempt Certificate when approving USD viático (if configured)
      if (monedaStr.toUpperCase() === 'USD' && sol.empresa_id) {
        const { data: empDataRaw } = await supabaseServer
          .from('empresas')
          .select('*')
          .eq('id', sol.empresa_id)
          .maybeSingle();

        const empData = empDataRaw as Record<string, unknown> | null;
        const certUrl = (empData?.url_certificado_usa as string | undefined) || (empData?.url_certificado_tax_exempt as string | undefined);
        const certNombre = (empData?.nombre_certificado_usa as string | undefined) || 'Certificado Fiscal EE. UU.';

        if (certUrl) {
          await enviarArchivoWhatsApp(
            telefono,
            certUrl,
            `📄 *${certNombre}*\nDocumento fiscal de la empresa para compras en EE. UU. Puedes presentarlo en caja si la compra califica para tratamiento fiscal especial o exención.`,
            'Certificado_Fiscal_USA.pdf'
          );
        }
      }
    }

    revalidatePath('/dashboard/solicitudes');
    revalidatePath('/dashboard/justificacion');
    revalidatePath('/dashboard');

    return {
      success: true,
      url: urlComprobanteTransferencia,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : 'Error al aprobar la solicitud';
    console.error('❌ [aprobarSolicitudConComprobanteAction] Exception:', err);
    return { success: false, error: msg };
  }
}

/**
 * @name adjuntarComprobanteTransferenciaPosteriorAction
 * @description [Business Logic]: Attaches a bank transfer receipt to an already approved travel
 * allowance and immediately sends the proof to the employee via WhatsApp.
 */
export async function adjuntarComprobanteTransferenciaPosteriorAction(
  formData: FormData
): Promise<SolicitudActionResult> {
  try {
    const solicitudId = formData.get('solicitudId') as string;
    const file = formData.get('file') as File | null;
    const referenciaTransferencia = (formData.get('referenciaTransferencia') as string | null)?.trim() || null;
    const notasDesembolso = (formData.get('notasDesembolso') as string | null)?.trim() || null;

    if (!solicitudId) {
      return { success: false, error: 'Identificador de solicitud inválido.' };
    }

    if (!file || file.size === 0) {
      return { success: false, error: 'Debes seleccionar el comprobante de transferencia bancaria.' };
    }

    // 1. Fetch solicitud details
    const { data: sol, error: fetchErr } = await supabaseServer
      .from('solicitudes_viaticos')
      .select('id, monto_solicitado, monto_aprobado, moneda, usuario_id, empresa_id, proyecto_id, proyectos(nombre), usuarios(telefono_whatsapp, nombre)')
      .eq('id', solicitudId)
      .single();

    if (fetchErr || !sol) {
      return { success: false, error: 'No se pudo encontrar la solicitud de viáticos.' };
    }

    // 2. Upload file
    const uploadResult = await uploadComprobanteTransferenciaStorage(file, solicitudId);
    if (uploadResult.error || !uploadResult.url) {
      return { success: false, error: uploadResult.error || 'Error al subir el comprobante.' };
    }

    const urlComprobante = uploadResult.url;
    const nowIso = new Date().toISOString();

    // 3. Update solicitudes_viaticos
    const updatePayload: Record<string, unknown> = {
      url_comprobante_transferencia: urlComprobante,
      referencia_transferencia: referenciaTransferencia,
      notas_desembolso: notasDesembolso,
      fecha_transferencia: nowIso,
    };

    let { error: updateError } = await supabaseServer
      .from('solicitudes_viaticos')
      .update(updatePayload)
      .eq('id', solicitudId);

    if (updateError && updateError.code === '42703') {
      return {
        success: false,
        error: 'Las columnas de transferencia no existen aún en la base de datos. Por favor ejecuta la migración 013 en Supabase.',
      };
    }

    if (updateError) {
      return { success: false, error: updateError.message };
    }

    // 4. Also update viaticos table
    await supabaseServer
      .from('viaticos')
      .update(updatePayload)
      .eq('id', solicitudId);

    // 5. Send WhatsApp notification with the attachment
    const rawUsuario = (Array.isArray(sol.usuarios) ? sol.usuarios[0] : sol.usuarios) as
      | { telefono_whatsapp?: string; nombre?: string }
      | null
      | undefined;
    const telefono = rawUsuario?.telefono_whatsapp;

    if (telefono) {
      const rawProyecto = (Array.isArray(sol.proyectos) ? sol.proyectos[0] : sol.proyectos) as
        | { nombre?: string }
        | null
        | undefined;
      const proyectoNombre = rawProyecto?.nombre || 'General';
      const monedaStr = sol.moneda || 'USD';
      const montoEfectivo = Number(sol.monto_aprobado ?? sol.monto_solicitado ?? 0);
      const montoFormateado = montoEfectivo.toLocaleString('es-VE', {
        minimumFractionDigits: 2,
        maximumFractionDigits: 2,
      });

      const refTexto = referenciaTransferencia ? `\n🔢 *Referencia:* ${referenciaTransferencia}` : '';
      const notaTexto = notasDesembolso ? `\n📝 *Nota:* ${notasDesembolso}` : '';

      const caption =
        `💸 *Comprobante de Transferencia de Viático*\n\n` +
        `📌 *Proyecto:* ${proyectoNombre}\n` +
        `💵 *Monto Transferido:* ${montoFormateado} ${monedaStr}` +
        `${refTexto}${notaTexto}\n\n` +
        `Aquí tienes el soporte bancario de tu transferencia. Ya puedes comenzar a rendir tus gastos.`;

      const isPdf = /\.(pdf)$/i.test(urlComprobante.split('?')[0]);
      const filename = isPdf ? 'Comprobante_Transferencia.pdf' : 'Comprobante_Transferencia.jpg';

      await enviarArchivoWhatsApp(telefono, urlComprobante, caption, filename);
    }

    revalidatePath('/dashboard/solicitudes');
    revalidatePath('/dashboard/justificacion');
    revalidatePath('/dashboard');

    return {
      success: true,
      url: urlComprobante,
    };
  } catch (err) {
    const msg = err instanceof Error ? err.message : 'Error al registrar el comprobante';
    console.error('❌ [adjuntarComprobanteTransferenciaPosteriorAction] Exception:', err);
    return { success: false, error: msg };
  }
}

/**
 * @name aprobarSolicitud
 * @description [Backwards Compatibility]: Direct approval without transfer proof.
 */
export async function aprobarSolicitud(id: string): Promise<{ error: string | null }> {
  const formData = new FormData();
  formData.append('solicitudId', id);
  const result = await aprobarSolicitudConComprobanteAction(formData);
  return { error: result.success ? null : (result.error || 'Error al aprobar') };
}

/**
 * @name rechazarSolicitud
 * @description [Business Logic]: Rejects a travel allowance request and sends an explanation note to the employee via WhatsApp.
 */
export async function rechazarSolicitud(id: string, motivo: string): Promise<{ error: string | null }> {
  try {
    const { data: sol, error: fetchErr } = await supabaseServer
      .from('solicitudes_viaticos')
      .select('monto_solicitado, moneda, usuario_id, proyecto_id, proyectos(nombre), usuarios(telefono_whatsapp)')
      .eq('id', id)
      .single();

    if (fetchErr || !sol) return { error: 'No se pudo encontrar la solicitud' };

    const { error } = await supabaseServer
      .from('solicitudes_viaticos')
      .update({
        estado: 'RECHAZADO',
        motivo_rechazo: motivo || null,
      })
      .eq('id', id);

    if (error) return { error: error.message };

    // Sincronizar en tabla viaticos
    await supabaseServer
      .from('viaticos')
      .update({
        estado: 'RECHAZADO',
        actualizado_en: new Date().toISOString(),
      })
      .eq('id', id);

    // Notificar por WhatsApp al empleado
    const rawUsuario = (Array.isArray(sol.usuarios) ? sol.usuarios[0] : sol.usuarios) as
      | { telefono_whatsapp?: string; nombre?: string }
      | null
      | undefined;
    const telefono = rawUsuario?.telefono_whatsapp;

    if (telefono) {
      const rawProyecto = (Array.isArray(sol.proyectos) ? sol.proyectos[0] : sol.proyectos) as
        | { nombre?: string }
        | null
        | undefined;
      const proyectoNombre = rawProyecto?.nombre || 'General';
      const monedaStr = sol.moneda || 'USD';
      const motivoTexto = motivo ? `\n💬 *Motivo:* ${motivo}` : '';
      const mensajeWA =
`❌ *SOLICITUD DE VIÁTICOS RECHAZADA*

📌 *Solicitud #:* ${id.slice(0, 8)}…
📁 *Proyecto:* ${proyectoNombre}
💵 *Monto Solicitado:* ${sol.monto_solicitado} ${monedaStr}${motivoTexto}

_Por favor contacta a tu administración para más detalles._`;

      await enviarMensajeWhatsApp(telefono, mensajeWA);
    }

    revalidatePath('/dashboard/solicitudes');
    revalidatePath('/dashboard/justificacion');
    revalidatePath('/dashboard');
    return { error: null };
  } catch (err) {
    const msg = err instanceof Error ? err.message : 'Error inesperado';
    return { error: msg };
  }
}
</file>

<file path="components/auth/LoginForm.tsx">
'use client';

import React, { useState, useTransition } from 'react';
import Link from 'next/link';
import { useRouter } from 'next/navigation';
import { Icon } from '@/components/landing/primitives';
import { RendyLogo } from '@/components/rendy-logo';
import { loginWithCredentialsAction } from '@/app/actions/auth.actions';

/**
 * @name LoginForm
 * @description [Business Logic]: Manages corporate user authentication via Argon2id constant-time
 * credential verification, Redis rate-limiting, anti-enumeration error handling, and role-based
 * routing (/dashboard for Project Administrators, /portal for Employees).
 */
export function LoginForm() {
  const router = useRouter();
  const [email, setEmail] = useState('');
  const [password, setPassword] = useState('');
  const [showPassword, setShowPassword] = useState(false);
  const [rememberMe, setRememberMe] = useState(true);
  const [errorMessage, setErrorMessage] = useState<string | null>(null);
  const [isPending, startTransition] = useTransition();

  /**
   * @name handleSubmit
   * @description Authenticates credentials against the Zero-Trust auth action and redirects by RBAC role.
   */
  const handleSubmit = (e: React.FormEvent<HTMLFormElement>) => {
    e.preventDefault();
    setErrorMessage(null);

    startTransition(async () => {
      const result = await loginWithCredentialsAction({ email, password });

      if (!result.success || !result.redirectTo) {
        setErrorMessage(result.error || 'Credenciales inválidas. Verifica tu correo y contraseña.');
        return;
      }

      router.push(result.redirectTo);
      router.refresh();
    });
  };

  /**
   * @name handleSSOLogin
   * @description Displays enterprise SSO status until SAML/OIDC tenant federation is configured.
   */
  const handleSSOLogin = (provider: 'google' | 'microsoft') => {
    const providerLabel = provider === 'google' ? 'Google Workspace' : 'Microsoft 365';
    setErrorMessage(
      `El inicio de sesión federado con ${providerLabel} debe ser habilitado primero por el administrador de tu organización.`
    );
  };

  return (
    <div className="w-full lg:w-[55%] xl:w-[58%] 2xl:w-[60%] bg-surface flex flex-col justify-between min-h-screen relative p-6 sm:p-10 lg:p-12">
      {/* Header bar: Telemetry & Gateway Status */}
      <header className="w-full flex items-center justify-between z-20 pb-4 animate-enter-down">
        {/* Mobile Brand Logo */}
        <div className="flex items-center gap-2 lg:hidden">
          <Link href="/">
            <RendyLogo className="h-7 w-auto" />
          </Link>
        </div>

        {/* Desktop Secure Gateway Indicator */}
        <div className="hidden lg:flex items-center gap-2 text-on-surface-variant font-label-md text-label-md">
          <Icon name="terminal" className="text-primary-container text-[20px]" />
          <span>Secure FinTech Gateway</span>
        </div>

        {/* System Telemetry Link / Indicator */}
        <div className="font-label-md text-label-md text-on-surface-variant hover:text-on-surface transition-colors flex items-center gap-1.5 cursor-default select-none">
          <span>System Telemetry</span>
          <span className="relative flex h-2 w-2 ml-0.5">
            <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-container opacity-75" />
            <span className="relative inline-flex rounded-full h-2 w-2 bg-primary-container" />
          </span>
        </div>
      </header>

      {/* Main Content Area */}
      <main className="w-full flex-1 flex flex-col justify-center max-w-md mx-auto py-8 relative z-10">
        <div className="w-full flex flex-col">
          {/* Top Environment Bar */}
          <div
            className="flex items-center justify-between mb-4 bg-surface-container-low px-4 py-2 rounded-xl border border-outline-variant/20 shadow-sm animate-enter-down"
            style={{ animationDelay: '80ms' }}
          >
            <div className="flex items-center gap-2">
              <span className="relative flex h-2 w-2">
                <span className="animate-ping absolute inline-flex h-full w-full rounded-full bg-primary-container opacity-75" />
                <span className="relative inline-flex rounded-full h-2 w-2 bg-primary-container" />
              </span>
              <span className="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wider font-semibold">
                Entorno Seguro Zero-Trust v2.14
              </span>
            </div>

            <span className="font-label-sm text-label-sm text-primary-container font-semibold">
              Ed25519 • Argon2id
            </span>
          </div>

          {/* Main Auth Card */}
          <div
            className="bg-surface-container-lowest/85 backdrop-blur-xl rounded-2xl p-6 sm:p-8 border border-outline-variant/30 shadow-2xl relative overflow-hidden animate-enter-card"
            style={{ animationDelay: '140ms' }}
          >
            {/* Ambient glow accent */}
            <div
              className="absolute -top-24 -right-24 w-64 h-64 bg-primary-container/10 rounded-full blur-[80px] pointer-events-none"
              aria-hidden="true"
            />

            {/* Header Section */}
            <div className="relative z-10 mb-6">
              <div className="inline-flex items-center gap-1.5 px-3 py-1 rounded-full bg-surface-container mb-3 border border-outline-variant/20">
                <Icon name="shield" className="text-primary-container text-[14px]" />
                <span className="font-label-sm text-label-sm text-on-surface-variant uppercase tracking-wide font-bold">
                  Acceso Seguro Corporativo
                </span>
              </div>
              <h2 className="font-display text-[30px] sm:text-[34px] font-bold text-on-surface tracking-tight leading-tight">
                ¡Bienvenido de nuevo!
              </h2>
              <p className="font-body-md text-body-md text-on-surface-variant mt-1.5">
                Ingresa a tu cuenta para continuar gestionando tus finanzas corporativas.
              </p>
            </div>

            {/* Dynamic Feedback Banner */}
            {errorMessage && (
              <div
                className="relative z-10 mb-5 p-4 rounded-xl bg-error-container/40 border border-error/40 text-on-error-container animate-in fade-in slide-in-from-top-2 duration-300"
                role="alert"
              >
                <div className="flex items-start gap-3">
                  <Icon name="error" className="text-error text-[22px] shrink-0 mt-0.5" />
                  <div>
                    <p className="font-label-md text-label-md font-bold text-white">
                      No se pudo iniciar sesión
                    </p>
                    <p className="font-label-sm text-label-sm text-on-surface-variant mt-0.5 leading-relaxed">
                      {errorMessage}
                    </p>
                  </div>
                </div>
              </div>
            )}

            {/* Authentication Form */}
            <form onSubmit={handleSubmit} className="space-y-4 relative z-10">
              {/* Field 1: Correo electrónico */}
              <div>
                <label
                  htmlFor="email-field"
                  className="font-label-md text-label-md text-on-surface mb-1.5 flex items-center justify-between"
                >
                  <span className="font-semibold">Correo electrónico</span>
                  <span className="font-label-sm text-label-sm text-on-surface-variant font-medium">
                    Admin / Empleado
                  </span>
                </label>
                <div className="relative rounded-xl bg-surface-container-high border border-outline-variant/30 focus-within:border-primary-container focus-within:ring-2 focus-within:ring-primary-container/20 transition-all">
                  <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-on-surface-variant">
                    <Icon name="alternate_email" className="text-[20px]" />
                  </div>
                  <input
                    id="email-field"
                    type="email"
                    value={email}
                    onChange={(e) => setEmail(e.target.value)}
                    placeholder="nombre@empresa.com"
                    required
                    disabled={isPending}
                    className="w-full pl-11 pr-4 py-3 bg-transparent rounded-xl text-on-surface font-body-md text-body-md placeholder-on-surface-variant/40 focus:outline-none transition-colors"
                  />
                </div>
              </div>

              {/* Field 2: Contraseña */}
              <div>
                <label
                  htmlFor="password-field"
                  className="block font-label-md text-label-md text-on-surface mb-1.5 font-semibold"
                >
                  Contraseña
                </label>
                <div className="relative rounded-xl bg-surface-container-high border border-outline-variant/30 focus-within:border-primary-container focus-within:ring-2 focus-within:ring-primary-container/20 transition-all">
                  <div className="absolute inset-y-0 left-0 pl-3.5 flex items-center pointer-events-none text-on-surface-variant">
                    <Icon name="lock" className="text-[20px]" />
                  </div>
                  <input
                    id="password-field"
                    type={showPassword ? 'text' : 'password'}
                    value={password}
                    onChange={(e) => setPassword(e.target.value)}
                    placeholder="Ingresa tu contraseña"
                    required
                    disabled={isPending}
                    className="w-full pl-11 pr-11 py-3 bg-transparent rounded-xl text-on-surface font-body-md text-body-md placeholder-on-surface-variant/40 focus:outline-none transition-colors"
                  />
                  <button
                    type="button"
                    onClick={() => setShowPassword((prev) => !prev)}
                    className="absolute inset-y-0 right-0 pr-3.5 flex items-center text-on-surface-variant hover:text-on-surface transition-colors cursor-pointer"
                    aria-label={showPassword ? 'Ocultar contraseña' : 'Ver contraseña'}
                  >
                    <Icon
                      name={showPassword ? 'visibility_off' : 'visibility'}
                      className="text-[20px]"
                    />
                  </button>
                </div>
              </div>

              {/* Utilities Row: Remember Me & Forgot Password */}
              <div className="flex items-center justify-between pt-1 font-label-md text-label-md">
                <label className="flex items-center gap-2 cursor-pointer select-none group">
                  <input
                    type="checkbox"
                    checked={rememberMe}
                    onChange={(e) => setRememberMe(e.target.checked)}
                    className="w-4 h-4 rounded border-outline-variant bg-surface-container-high accent-[#00e599] cursor-pointer"
                  />
                  <span className="text-on-surface-variant group-hover:text-on-surface transition-colors">
                    Recordarme en este equipo
                  </span>
                </label>
                <Link
                  href="#recuperar"
                  onClick={(e) => {
                    e.preventDefault();
                    setErrorMessage(
                      'Para restablecer tu contraseña de forma segura, contacta al administrador de tu organización.'
                    );
                  }}
                  className="text-primary-container hover:underline transition-colors font-medium"
                >
                  ¿Olvidaste tu contraseña?
                </Link>
              </div>

              {/* Submit Button */}
              <button
                type="submit"
                disabled={isPending}
                className="w-full py-3.5 px-6 rounded-xl bg-primary-container text-on-primary-fixed font-headline-sm text-[16px] font-bold shadow-glow hover:shadow-glow-lg hover:scale-[1.01] active:scale-[0.99] transition-all flex items-center justify-center gap-2 cursor-pointer disabled:opacity-75 disabled:pointer-events-none mt-2"
              >
                {isPending ? (
                  <span>Verificando credenciales...</span>
                ) : (
                  <>
                    <span>Iniciar sesión</span>
                    <Icon name="arrow_forward" className="text-[20px] font-bold" />
                  </>
                )}
              </button>
            </form>

            {/* Divider */}
            <div className="relative my-6 flex items-center justify-center">
              <div className="w-full bg-surface-container-high h-[1px]" />
              <span className="absolute bg-surface-container-lowest px-3 font-label-sm text-label-sm uppercase tracking-wider text-on-surface-variant">
                O continúa con
              </span>
            </div>

            {/* SSO Corporate Providers */}
            <div className="grid grid-cols-1 sm:grid-cols-2 gap-3 mb-6">
              {/* Google Workspace */}
              <button
                type="button"
                disabled={isPending}
                onClick={() => handleSSOLogin('google')}
                className="flex items-center justify-center gap-2.5 py-3 px-4 bg-surface-container hover:bg-surface-container-high rounded-xl text-on-surface font-label-md text-label-md font-semibold transition-all group border border-outline-variant/20 hover:border-outline-variant/40 cursor-pointer shadow-sm"
              >
                <svg className="w-4 h-4 shrink-0" viewBox="0 0 24 24" aria-hidden="true">
                  <path
                    d="M23.745 12.27c0-.7-.06-1.4-.19-2.07H12v4.51h6.6c-.29 1.52-1.14 2.8-2.4 3.65v3.05h3.88c2.27-2.09 3.665-5.17 3.665-9.14z"
                    fill="#4285F4"
                  />
                  <path
                    d="M12 24c3.24 0 5.95-1.08 7.93-2.91l-3.88-3.05c-1.08.72-2.45 1.16-4.05 1.16-3.12 0-5.77-2.1-6.72-4.93H1.25v3.15C3.26 21.36 7.33 24 12 24z"
                    fill="#34A853"
                  />
                  <path
                    d="M5.28 14.27c-.25-.72-.38-1.49-.38-2.27s.13-1.55.38-2.27V6.58H1.25C.45 8.17 0 9.97 0 12s.45 3.83 1.25 5.42l4.03-3.15z"

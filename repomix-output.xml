<file path="components/landing/Pricing.tsx">
'use client';

import { useState } from "react";

import {
  ANNUAL_DISCOUNT_LABEL,
  PLANS,
  billingNote,
  planPrice,
  type BillingCycle,
} from "@/lib/pricing";
import { cn } from "@/lib/utils";

import { Icon, Reveal } from "./primitives";

/**
 * @name PricingSection
 * @description [Business Logic]: Renders transparent commercial tiers (Starter, Growth, Enterprise)
 * with real-time bimonthly/annual discount calculations (-20% savings) to drive customer acquisition
 * and showcase automated expense management value.
 */
export function PricingSection() {
  const [cycle, setCycle] = useState<BillingCycle>("monthly");
  const [hasToggled, setHasToggled] = useState(false);

  const handleCycleChange = (nextCycle: BillingCycle) => {
    if (nextCycle === cycle) return;
    setHasToggled(true);
    setCycle(nextCycle);
  };

  const toggleClass = (active: boolean) =>
    cn(
      "group relative px-5 py-2 rounded-xl text-label-md font-semibold flex items-center gap-2 cursor-pointer select-none border origin-center",
      "transition-all duration-200 ease-out will-change-transform",
      active
        ? "text-on-surface bg-surface-bright border-outline-variant/30 shadow-sm z-10"
        : "text-on-surface-variant border-transparent z-0 hover:text-on-surface hover:bg-surface-bright/70 hover:border-outline-variant/40 hover:shadow-md hover:scale-[1.035] hover:z-20 active:scale-[0.98]",
    );

  return (
    <section id="planes" className="w-full bg-surface-container-lowest py-24">
      <div className="max-w-[1320px] mx-auto px-6">
        <Reveal className="text-center max-w-3xl mx-auto mb-12">
          <span className="text-label-sm text-primary uppercase tracking-widest font-semibold">
            PLANES TRANSPARENTES
          </span>
          <h2 className="font-display text-headline-xl-mobile md:text-headline-xl font-bold text-on-surface mt-2">
            Encuentra el plan adecuado para tu empresa.
          </h2>
          <p className="text-body-md text-on-surface-variant mt-3 max-w-2xl mx-auto">
            Automatiza la rendición de viáticos y reembolsos por WhatsApp con IA contable. 7 días
            de prueba gratis en todos los planes, cancela cuando quieras.
          </p>
          <div
            role="group"
            aria-label="Ciclo de facturación"
            className="mt-8 inline-flex flex-wrap justify-center items-center p-2 rounded-2xl bg-surface-container-high/60 backdrop-blur-md shadow-inner gap-2 border border-outline-variant/20"
          >
            <button
              type="button"
              aria-pressed={cycle === "monthly"}
              onClick={() => handleCycleChange("monthly")}
              className={toggleClass(cycle === "monthly")}
            >
              Facturación Mensual
            </button>
            <button
              type="button"
              aria-pressed={cycle === "annual"}
              onClick={() => handleCycleChange("annual")}
              className={toggleClass(cycle === "annual")}
            >
              <span>Facturación Anual</span>
              <span className="px-2 py-0.5 rounded-full text-label-sm font-bold bg-primary-container text-on-primary-fixed transition-transform duration-200 group-hover:scale-105">
                {ANNUAL_DISCOUNT_LABEL}

        {NAV_ITEMS.map((section) => (
          <div key={section.label}>
            <div className="nav-section-label">{section.label}</div>
            {section.items.map((item) => {
              const Icon = item.icon;
              const isActive = pathname === item.href || (item.href !== '/dashboard' && pathname.startsWith(item.href));
              return (
                <Link
                  key={item.href}
                  href={item.href}
                  className={`nav-item ${isActive ? 'active' : ''}`}
                  title={collapsed ? item.label : undefined}
                  aria-current={isActive ? 'page' : undefined}
                >
                  <span className="nav-item-icon">
                    <Icon size={18} strokeWidth={isActive ? 2.2 : 1.8} />
                  </span>
                  <span className="nav-item-label">{item.label}</span>
                  {item.badge && (
                    <span className="nav-badge" aria-label={`${item.badge} pendientes`}>
                      {item.badge}
                    </span>
                  )}
                </Link>
              );
            })}
          </div>
        ))}
      </div>

      {/* Footer — Org Info */}
      <div className="sidebar-footer">
        <div className="sidebar-org-pill">
          <div className="sidebar-org-avatar" aria-hidden="true">UA</div>
          <div className="sidebar-org-info">
            <div className="sidebar-org-name">UAT Empresa</div>
            <div className="sidebar-org-role">Admin · Multi-tenant</div>
          </div>
        </div>
      </div>
    </nav>
  );
}

/* ============================================================
   Topbar Component
   ============================================================ */
const PAGE_LABELS: Record<string, string> = {
  '/dashboard': 'Dashboard',
  '/dashboard/solicitudes': 'Solicitudes de Viáticos',
  '/dashboard/justificacion': 'Progreso de Justificación',
  '/dashboard/reembolsos': 'Reembolsos',
  '/dashboard/configuracion': 'Organización',
};

function Topbar() {
  const pathname = usePathname();
  const pageLabel = PAGE_LABELS[pathname] ?? 'Dashboard';

  return (
    <header className="topbar" role="banner">
      {/* Breadcrumb */}
      <div className="topbar-breadcrumb" aria-label="Ruta de navegación">
        <span className="topbar-breadcrumb-root">Rendy</span>
        <ChevronRight size={12} className="topbar-breadcrumb-sep" aria-hidden="true" />
        <span className="topbar-breadcrumb-page">{pageLabel}</span>
      </div>

      {/* Actions */}
      <div className="topbar-actions">
        <button className="topbar-btn" aria-label="Buscar" id="topbar-search-btn">
          <Search size={16} />
        </button>
        <button className="topbar-btn" aria-label="Notificaciones" id="topbar-notifications-btn">
          <Bell size={16} />
          <span className="topbar-btn-dot" aria-label="Hay notificaciones nuevas" />
        </button>
        <button className="topbar-btn" aria-label="Cerrar sesión" id="topbar-logout-btn">
          <LogOut size={16} />
        </button>
        <div
          className="topbar-avatar"
          role="img"
          aria-label="Avatar de usuario: Admin"
          title="Admin"
        >
          A
        </div>
      </div>
    </header>
  );
}

/* ============================================================
   Dashboard Layout Shell
   ============================================================ */
export default function DashboardLayout({ children }: { children: React.ReactNode }) {
  const [collapsed, setCollapsed] = useState(false);

  return (
    <SidebarContext.Provider value={{ collapsed }}>
      <div className="dashboard-shell">
        <Sidebar collapsed={collapsed} onToggle={() => setCollapsed((c) => !c)} />
        <div className={`main-content ${collapsed ? 'sidebar-collapsed' : ''}`}>
          <Topbar />
          <main className="page-area" id="main-content" tabIndex={-1}>
            {children}
          </main>
        </div>
      </div>
    </SidebarContext.Provider>
  );
}

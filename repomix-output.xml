                  <th style={{ textAlign: 'right' }}>Acciones</th>
                </tr>
              </thead>
              <tbody>
                {filtered.length === 0 ? (
                  <tr>
                    <td colSpan={9} style={{ textAlign: 'center', padding: '48px', color: 'var(--text-muted)' }}>
                      Sin resultados.
                    </td>
                  </tr>
                ) : filtered.map((sol) => {
                  const mStr = sol.moneda || 'USD';
                  return (

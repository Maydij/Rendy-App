                    plan.featured
                      ? "font-bold bg-primary-container text-on-primary-fixed shadow-glow-md hover:shadow-glow-lg hover:-translate-y-0.5"
                      : "font-semibold border border-outline-variant/60 text-on-surface hover:bg-surface-bright",
                  )}

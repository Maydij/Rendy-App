                                  className="badge"
                                  style={{
                                    background: 'rgba(16, 185, 129, 0.15)',
                                    color: 'var(--rendy-accent)',
                                    borderColor: 'rgba(16, 185, 129, 0.35)',
                                    fontSize: '11px',
                                    fontWeight: 700,
                                    padding: '3px 8px',
                                  }}
                                >
                                  <span className="badge-dot" style={{ background: 'var(--rendy-accent)' }} />

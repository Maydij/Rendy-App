                                    color: 'var(--rendy-warning)',
                                    borderColor: 'rgba(245, 158, 11, 0.35)',
                                    fontSize: '11px',
                                    fontWeight: 700,
                                    padding: '3px 8px',
                                  }}
                                >
                                  <span className="badge-dot" style={{ background: 'var(--rendy-warning)' }} />

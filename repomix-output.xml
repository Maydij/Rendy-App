                        >
                          <span style={{ fontSize: '11px', color: 'var(--text-muted)' }}>
                            Deduce del viático:{' '}
                            <strong style={{ color: 'var(--text-primary)' }}>
                              {gasto.monto_efectivo.toLocaleString('es-VE', { minimumFractionDigits: 2 })} {selectedSolicitud.moneda}
                            </strong>
                          </span>

                          <div>
                            {gasto.url_comprobante ? (
                              <div style={{ display: 'flex', gap: '6px' }}>
                                <button
                                  className="btn btn-sm"
                                  onClick={() =>
                                    setSelectedGastoInvoice({
                                      id: gasto.id,
                                      empleado: selectedSolicitud.empleado,
                                      categoria: gasto.categoria,
                                      comercio: gasto.comercio,
                                      monto: gasto.monto,
                                      moneda: gasto.moneda,
                                      tasa_cambio: gasto.tasa_cambio,
                                      monto_convertido: gasto.monto_convertido,
                                      moneda_viatico: selectedSolicitud.moneda,
                                      fecha_gasto: gasto.fecha_gasto,
                                      creado_en: gasto.creado_en,
                                      proyecto: selectedSolicitud.proyecto,
                                      metodo_pago: 'Rendición de Viáticos',
                                      estado: gasto.estado,
                                      url_comprobante: gasto.url_comprobante,
                                      concepto: gasto.concepto,
                                      moneda_original: gasto.moneda_original,
                                      origen_tasa: gasto.origen_tasa,
                                      base_imponible_ves: gasto.base_imponible_ves,
                                      iva_ves: gasto.iva_ves,
                                      exento_ves: gasto.exento_ves,
                                      igtf_ves: gasto.igtf_ves,
                                      monto_ves: gasto.monto_ves,
                                      monto_usd: gasto.monto_usd,
                                      rif_comercio: gasto.rif_comercio,
                                      numero_factura: gasto.numero_factura,
                                      requiere_revision_fiscal: gasto.requiere_revision_fiscal,
                                    })
                                  }
                                  style={{
                                    background: 'rgba(99, 102, 241, 0.15)',
                                    color: 'var(--rendy-primary-light)',
                                    border: '1px solid rgba(99, 102, 241, 0.3)',
                                    gap: '5px',
                                    padding: '4px 10px',
                                    fontSize: '11px',
                                    fontWeight: 600,
                                    borderRadius: '6px',
                                    cursor: 'pointer',
                                  }}
                                >
                                  <Eye size={12} /> Ver Factura
                                </button>
                                <a
                                  href={gasto.url_comprobante}
                                  target="_blank"
                                  rel="noopener noreferrer"
                                  className="btn btn-ghost btn-sm"
                                  style={{ padding: '4px 8px', fontSize: '11px', borderRadius: '6px' }}
                                  title="Abrir en pestaña nueva"
                                >
                                  <ExternalLink size={12} />
                                </a>
                              </div>
                            ) : (
                              <span style={{ fontSize: '11px', color: 'var(--text-muted)', fontStyle: 'italic' }}>
                                Sin imagen adjunta
                              </span>
                            )}
                          </div>
                        </div>
                      </div>
                    );
                  })}
                </div>
              )}
            </div>

            {/* Modal Footer */}
            <div
              style={{
                padding: '16px 24px',
                borderTop: '1px solid var(--bg-border)',
                display: 'flex',
                justifyContent: 'space-between',
                alignItems: 'center',
                background: 'var(--bg-elevated)',
              }}
            >
              <div style={{ fontSize: '12px', color: 'var(--text-muted)' }}>
                {selectedSolicitud.gastos.length} comprobante{selectedSolicitud.gastos.length !== 1 ? 's' : ''} justificado{selectedSolicitud.gastos.length !== 1 ? 's' : ''}
              </div>
              <button
                className="btn btn-primary btn-sm"
                onClick={() => setSelectedSolicitud(null)}
                style={{ padding: '8px 16px', borderRadius: '8px', fontWeight: 600 }}
              >
                Cerrar
              </button>
            </div>
          </div>
        </div>
      )}

      {/* ── Digital Invoice Modal (eReceipt) ── */}
      {selectedGastoInvoice && (
        <DigitalInvoice
          gasto={selectedGastoInvoice}
          onClose={handleCloseInvoice}
        />
      )}
    </>
  );
}
</file>

<file path="app/dashboard/layout.tsx">
'use client';

import { useState, createContext, useContext, useEffect } from 'react';
import {
  LayoutDashboard,
  Wallet,
  ClipboardCheck,
  RotateCcw,
  Receipt,
  Settings,
  FileSpreadsheet,
  ChevronLeft,
  ChevronRight,
  Bell,
  Search,
  LogOut,
  Menu,
} from 'lucide-react';
import Link from 'next/link';
import { usePathname } from 'next/navigation';
import { supabase } from '@/lib/supabase';
import { RendyLogo } from '@/components/rendy-logo';

const SidebarContext = createContext({ collapsed: false });
export const useSidebar = () => useContext(SidebarContext);

export default function DashboardLayout({ children }: { children: React.ReactNode }) {
  const [collapsed, setCollapsed] = useState(false);
  const [mobileMenuOpen, setMobileMenuOpen] = useState(false);
  const [pendingViaticos, setPendingViaticos] = useState<number>(0);
  const [pendingReembolsos, setPendingReembolsos] = useState<number>(0);
  const pathname = usePathname();

  useEffect(() => {
    setMobileMenuOpen(false);
  }, [pathname]);

  useEffect(() => {
    async function fetchCounts() {
      // Contar viáticos pendientes
      const { count: vCount } = await supabase
        .from('solicitudes_viaticos')
        .select('*', { count: 'exact', head: true })
        .eq('estado', 'PENDIENTE');

      // Contar reembolsos pendientes
      const { count: rCount } = await supabase
        .from('gastos')
        .select('*', { count: 'exact', head: true })
        .eq('es_reembolso', true)
        .eq('estado', 'PENDIENTE');

      setPendingViaticos(vCount || 0);
      setPendingReembolsos(rCount || 0);
    }

    fetchCounts();
  }, [pathname]);

  const NAV_ITEMS = [
    {
      label: 'Principal',
      items: [
        { href: '/dashboard', icon: LayoutDashboard, label: 'Dashboard', badge: null },
      ],
    },
    {
      label: 'Operaciones',
      items: [
        { href: '/dashboard/solicitudes', icon: Wallet, label: 'Solicitudes de Viáticos', badge: pendingViaticos > 0 ? String(pendingViaticos) : null },
        { href: '/dashboard/justificacion', icon: ClipboardCheck, label: 'Progreso Justificación', badge: null },
        { href: '/dashboard/gastos', icon: Receipt, label: 'Gastos de Empresa', badge: null },
        { href: '/dashboard/reembolsos', icon: RotateCcw, label: 'Reembolsos', badge: pendingReembolsos > 0 ? String(pendingReembolsos) : null },
      ],
    },
    {
      label: 'Administración',
      items: [
        { href: '/dashboard/reportes', icon: FileSpreadsheet, label: 'Reportes Contables', badge: null },
        { href: '/dashboard/configuracion', icon: Settings, label: 'Organización', badge: null },
      ],
    },
  ];

  const PAGE_LABELS: Record<string, string> = {
    '/dashboard': 'Dashboard',
    '/dashboard/solicitudes': 'Solicitudes de Viáticos',
    '/dashboard/justificacion': 'Progreso de Justificación',
    '/dashboard/gastos': 'Gastos de Empresa',
    '/dashboard/reembolsos': 'Reembolsos',
    '/dashboard/reportes': 'Reportes Contables',
    '/dashboard/configuracion': 'Organización',
  };

  const pageLabel = PAGE_LABELS[pathname] ?? 'Dashboard';

  return (
    <SidebarContext.Provider value={{ collapsed }}>
      <div className="dashboard-shell">
        {mobileMenuOpen && (
          <div
            className="sidebar-backdrop"
            onClick={() => setMobileMenuOpen(false)}
            aria-label="Cerrar menú móvil"
          />
        )}

        <nav className={`sidebar ${collapsed ? 'collapsed' : ''} ${mobileMenuOpen ? 'mobile-open' : ''}`}>
          <div
            className="sidebar-brand"
            onClick={() => collapsed && setCollapsed(false)}
            style={{ cursor: collapsed ? 'pointer' : 'default' }}
            title={collapsed ? 'Expandir menú lateral' : undefined}
          >
            <div className="sidebar-brand-logo">
              <RendyLogo variant="mark" className="h-9 w-9" />
            </div>
            <div className="sidebar-brand-text">
              <span className="sidebar-brand-name">Rendy</span>
              <span className="sidebar-brand-tagline">by Swork · B2B SaaS</span>
            </div>
            {!collapsed ? (
              <button className="sidebar-toggle" onClick={(e) => { e.stopPropagation(); setCollapsed(true); }} title="Colapsar">
                <ChevronLeft size={16} />
              </button>
            ) : (
              <button className="sidebar-toggle" onClick={(e) => { e.stopPropagation(); setCollapsed(false); }} title="Expandir">
                <ChevronRight size={16} />
              </button>
            )}
          </div>

          <div className="sidebar-nav">
            {NAV_ITEMS.map((section) => (
              <div key={section.label}>
                <div className="nav-section-label">{section.label}</div>
                {section.items.map((item) => {
                  const Icon = item.icon;
                  const isActive = pathname === item.href || (item.href !== '/dashboard' && pathname.startsWith(item.href));
                  return (
                    <Link
                      key={item.href}
                      href={item.href}
                      className={`nav-item ${isActive ? 'active' : ''}`}
                      onClick={() => setMobileMenuOpen(false)}
                    >
                      <span className="nav-item-icon">
                        <Icon size={18} strokeWidth={isActive ? 2.2 : 1.8} />
                      </span>
                      <span className="nav-item-label">{item.label}</span>
                      {item.badge && <span className="nav-badge">{item.badge}</span>}
                    </Link>
                  );
                })}
              </div>
            ))}
          </div>

          <div className="sidebar-footer">
            <div className="sidebar-org-pill">
              <div className="sidebar-org-avatar">SD</div>
              <div className="sidebar-org-info">
                <div className="sidebar-org-name">Swork Demo</div>
                <div className="sidebar-org-role">Admin · SaaS</div>
              </div>
            </div>
          </div>
        </nav>

        <div className={`main-content ${collapsed ? 'sidebar-collapsed' : ''}`}>
          <header className="topbar">
            <button
              className="mobile-menu-btn"
              onClick={() => setMobileMenuOpen(true)}
              aria-label="Abrir menú de navegación"
            >
              <Menu size={18} />
            </button>
            <div className="topbar-breadcrumb">
              <span className="topbar-breadcrumb-root">Rendy</span>
              <ChevronRight size={12} className="topbar-breadcrumb-sep" />
              <span className="topbar-breadcrumb-page">{pageLabel}</span>
            </div>
            <div className="topbar-actions">
              <button className="topbar-btn" id="topbar-search-btn"><Search size={16} /></button>
              <button className="topbar-btn" id="topbar-notifications-btn">
                <Bell size={16} />
                <span className="topbar-btn-dot" />
              </button>
              <button className="topbar-btn" id="topbar-logout-btn"><LogOut size={16} /></button>
              <div className="topbar-avatar">A</div>
            </div>
          </header>

          <main className="page-area" id="main-content">
            {children}
          </main>
        </div>
      </div>
    </SidebarContext.Provider>
  );
}
</file>


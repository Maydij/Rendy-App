            <X size={16} />
          </button>
        </div>

        <form
          onSubmit={(e) => {
            e.preventDefault();
            onSubmit({
              nombre,
              descripcion,
              icono,
              limiteDiarioUsd: parseFloat(limiteDiario) || 0,
            });
          }}
          style={{ padding: '20px' }}
        >
          {/* Selector de Icono / Emoji */}
          <div style={{ marginBottom: '16px' }}>
            <label style={{ display: 'block', fontSize: '12px', fontWeight: 600, color: 'var(--text-primary)', marginBottom: '6px' }}>

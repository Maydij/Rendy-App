                style={{
                  background: 'var(--bg-elevated)',
                  border: '1px solid var(--bg-border)',
                  borderRadius: '6px',
                  padding: '5px 10px',
                  color: currentPage <= 1 ? 'var(--text-muted)' : 'var(--text-primary)',
                  cursor: currentPage <= 1 || isPending ? 'not-allowed' : 'pointer',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '4px',
                }}
              >
                <ChevronLeft size={14} />
                Anterior
              </button>

              <span style={{ padding: '0 8px', fontSize: '12px', color: 'var(--text-muted)' }}>
                Página {currentPage} de {totalPages}
              </span>

              <button
                type="button"
                onClick={() => handlePageChange(currentPage + 1)}
                disabled={currentPage >= totalPages || isPending}
                style={{
                  background: 'var(--bg-elevated)',
                  border: '1px solid var(--bg-border)',
                  borderRadius: '6px',
                  padding: '5px 10px',
                  color: currentPage >= totalPages ? 'var(--text-muted)' : 'var(--text-primary)',
                  cursor: currentPage >= totalPages || isPending ? 'not-allowed' : 'pointer',
                  display: 'inline-flex',
                  alignItems: 'center',
                  gap: '4px',
                }}
              >
                Siguiente
                <ChevronRight size={14} />
              </button>
            </div>
          </div>
        )}
      </div>

      {/* Digital Receipt Modal (Original Invoice) */}
      {selectedGasto && (
        <DigitalInvoice gasto={selectedGasto} onClose={handleCloseModal} />
      )}

      {/* Transfer Settlement Modal (File Upload to Storage) */}
      <ModalTransferirReembolso
        item={transferTarget}
        onClose={() => setTransferTarget(null)}
        onSuccess={(msg) => {
          setTransferTarget(null);
          setFeedback({
            type: 'success',
            message: msg,
          });
          router.refresh();
        }}
      />

      {/* Rejection Comment Modal */}
      <ModalRechazoReembolso
        isOpen={rejectionTarget !== null}
        comercio={rejectionTarget?.comercio || ''}
        montoLabel={`$${rejectionTarget?.monto_usd.toFixed(2)} USD`}
        isPending={isPending}
        onClose={() => setRejectionTarget(null)}
        onConfirm={handleRechazarConfirm}
      />
    </>
  );
}

/* ─────────────────────────────────────────────────────────────
 * Subcomponents & Helpers
 * ───────────────────────────────────────────────────────────── */

function RenderStatusBadge({
  estado,
  comentarioRechazo,
}: {
  estado: string;
  comentarioRechazo: string | null;
}) {
  switch (estado) {
    case 'PENDIENTE':
    case 'REQUIERE_APROBACION_ESPECIAL':
      return (
        <span className="badge pendiente">
          <span className="badge-dot" />
          Pendiente
        </span>
      );
    case 'PROCESADO':
    case 'APROBADO':
      return (
        <span
          style={{
            display: 'inline-flex',
            alignItems: 'center',
            gap: '6px',
            padding: '3px 10px',
            borderRadius: '20px',
            fontSize: '11px',
            fontWeight: 700,
            background: 'rgba(99, 102, 241, 0.15)',
            color: 'var(--rendy-primary-light)',
            border: '1px solid rgba(99, 102, 241, 0.3)',
          }}
        >
          <span style={{ width: '6px', height: '6px', borderRadius: '50%', background: 'var(--rendy-primary-light)' }} />
          Procesado
        </span>
      );
    case 'TRANSFERIDO':
      return (
        <span className="badge aprobado">
          <span className="badge-dot" />
          Transferido
        </span>
      );
    case 'RECHAZADO':
      return (
        <div style={{ display: 'inline-flex', flexDirection: 'column', alignItems: 'flex-start' }}>
          <span className="badge rechazado">
            <span className="badge-dot" />
            Rechazado
          </span>
          {comentarioRechazo && (
            <span
              title={comentarioRechazo}
              style={{
                fontSize: '10px',
                color: 'var(--rendy-danger)',
                marginTop: '3px',
                maxWidth: '120px',
                whiteSpace: 'nowrap',
                overflow: 'hidden',
                textOverflow: 'ellipsis',
              }}
            >
              {comentarioRechazo}
            </span>
          )}
        </div>
      );
    default:
      return (
        <span className="badge pendiente">
          <span className="badge-dot" />
          {estado}
        </span>
      );
  }
}

function MenuActionButton({
  icon: Icon,
  color,
  label,
  onClick,
  disabled,
}: {
  icon: React.ComponentType<{ size?: number; style?: React.CSSProperties }>;
  color: string;
  label: string;
  onClick: () => void;
  disabled?: boolean;
}) {
  return (
    <button
      type="button"
      onClick={onClick}
      disabled={disabled}
      style={{
        display: 'flex',
        alignItems: 'center',
        gap: '8px',
        padding: '7px 10px',
        background: 'transparent',
        border: 'none',
        borderRadius: '6px',
        color: 'var(--text-primary)',
        fontSize: '12px',
        fontWeight: 500,
        cursor: disabled ? 'not-allowed' : 'pointer',
        textAlign: 'left',
        width: '100%',
        transition: 'background 120ms ease',
      }}
      onMouseEnter={(e) => (e.currentTarget.style.background = 'var(--bg-overlay)')}
      onMouseLeave={(e) => (e.currentTarget.style.background = 'transparent')}
    >
      <Icon size={14} style={{ color }} />
      {label}
    </button>
  );
}

                                >
                                  <Paperclip size={12} /> Subir
                                </button>
                              </div>
                            )
                          ) : (
                            <span style={{ fontSize: '12px', color: 'var(--text-muted)' }}>—</span>
                          )}
                        </td>

                        {/* Acciones */}
                        <td style={{ verticalAlign: 'middle' }}>
                          {isPendingState ? (
                            <div style={{ display: 'flex', gap: '6px', justifyContent: 'flex-end' }}>
                              <button
                                id={`aprobar-${sol.id}`}

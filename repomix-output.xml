                const barClass = p.pct >= 80 ? 'warning' : p.pct >= 50 ? '' : 'accent';
                return (
                  <div key={p.nombre} style={{ marginBottom: '20px' }}>
                    <div style={{ display: 'flex', justifyContent: 'space-between', marginBottom: '6px' }}>

    bucketPrefix: 'rl:onboard',
    maxRequests: 20,
    windowSeconds: 10 * 60, // 20 step saves per 10 minutes
  },
} as const satisfies Record<string, RateLimitConfig>;

// In-memory fallback store used strictly when Redis is not configured in local dev
const memoryCounters = new Map<string, { count: number; expiresAt: number }>();
const memoryIdempotency = new Map<string, { payload: string; expiresAt: number }>();

/**
 * @name executeUpstashCommand
 * @description [Infrastructure]: Dispatches atomic REST commands to Upstash Redis.
 */
async function executeUpstashCommand<T>(commandParts: (string | number)[]): Promise<T | null> {
  const url = serverEnv.UPSTASH_REDIS_REST_URL;
  const token = serverEnv.UPSTASH_REDIS_REST_TOKEN;
  if (!url || !token) return null;

  const response = await fetch(url, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(commandParts),
    cache: 'no-store',
  });

  if (!response.ok) {
    throw new Error(`Redis command failed with status ${response.status}`);
  }

  const json = (await response.json()) as { result: T };
  return json.result;
}

/**
 * @name enforceRateLimit
 * @description [Business Logic]: Enforces distributed sliding/fixed-window rate limiting
 * across authentication, payment, and onboarding endpoints to neutralize brute-force and card-testing attacks.
 */
export async function enforceRateLimit(
  identifierHash: string,
  policy: RateLimitConfig
): Promise<RateLimitVerdict> {
  const key = `${policy.bucketPrefix}:${identifierHash}`;

  try {
    if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
      const currentCount = await executeUpstashCommand<number>(['INCR', key]);
      if (currentCount === 1) {
        await executeUpstashCommand<number>(['EXPIRE', key, policy.windowSeconds]);
      }

      const ttl = (await executeUpstashCommand<number>(['TTL', key])) ?? policy.windowSeconds;
      const count = currentCount ?? 1;

      if (count > policy.maxRequests) {
        return {
          allowed: false,
          remaining: 0,
          retryAfterSeconds: Math.max(1, ttl),
        };
      }

      return {
        allowed: true,
        remaining: Math.max(0, policy.maxRequests - count),
        retryAfterSeconds: 0,
      };
    }
  } catch (error) {
    console.error('⚠️ [RedisGuard] Fallback to local rate-limit store:', error);
  }

  // Fallback deterministic counter
  const now = Date.now();
  const existing = memoryCounters.get(key);
  if (!existing || existing.expiresAt <= now) {
    memoryCounters.set(key, {
      count: 1,
      expiresAt: now + policy.windowSeconds * 1000,
    });
    return { allowed: true, remaining: policy.maxRequests - 1, retryAfterSeconds: 0 };
  }

  existing.count += 1;
  if (existing.count > policy.maxRequests) {
    return {
      allowed: false,
      remaining: 0,
      retryAfterSeconds: Math.ceil((existing.expiresAt - now) / 1000),
    };
  }

  return {
    allowed: true,
    remaining: policy.maxRequests - existing.count,
    retryAfterSeconds: 0,
  };
}

/**
 * @name acquireIdempotencyLock
 * @description [Business Logic]: Atomically claims a UUIDv4 Idempotency-Key in Redis (`SETNX` with 24h TTL)
 * so concurrent or retried payment/subscription requests never execute duplicate Stripe charges.
 */
export async function acquireIdempotencyLock(
  idempotencyKey: string
): Promise<{ acquired: boolean; cachedResponse?: string }> {
  const redisKey = `idem:pay:${idempotencyKey}`;
  const ttlSeconds = 24 * 60 * 60; // 24 hours

  if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
    const setResult = await executeUpstashCommand<string | null>([
      'SET',
      redisKey,
      'IN_PROGRESS',
      'NX',
      'EX',
      ttlSeconds,
    ]);

    if (setResult === 'OK') {
      return { acquired: true };
    }

    const existingValue = await executeUpstashCommand<string | null>(['GET', redisKey]);
    return {
      acquired: false,
      cachedResponse: existingValue && existingValue !== 'IN_PROGRESS' ? existingValue : undefined,
    };
  }

  const now = Date.now();
  const existing = memoryIdempotency.get(redisKey);
  if (existing && existing.expiresAt > now) {
    return {
      acquired: false,
      cachedResponse: existing.payload !== 'IN_PROGRESS' ? existing.payload : undefined,
    };
  }

  memoryIdempotency.set(redisKey, {
    payload: 'IN_PROGRESS',
    expiresAt: now + ttlSeconds * 1000,
  });
  return { acquired: true };
}

/**
 * @name storeIdempotencyResult
 * @description [Business Logic]: Persists the finalized JSON response for an Idempotency-Key
 * for 24 hours so safe retries receive the exact original result.
 */
export async function storeIdempotencyResult(
  idempotencyKey: string,
  serializedPayload: string
): Promise<void> {
  const redisKey = `idem:pay:${idempotencyKey}`;
  const ttlSeconds = 24 * 60 * 60;

  if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
    await executeUpstashCommand<string>(['SET', redisKey, serializedPayload, 'EX', ttlSeconds]);
    return;
  }

  memoryIdempotency.set(redisKey, {
    payload: serializedPayload,
    expiresAt: Date.now() + ttlSeconds * 1000,
  });
}

/**
 * @name releaseIdempotencyLock
 * @description [Business Logic]: Releases an in-progress Idempotency-Key lock when an
 * upstream payment initialization fails prior to creating a charge or subscription,
 * allowing safe retries without triggering HTTP 409 Conflict.
 */
export async function releaseIdempotencyLock(idempotencyKey: string): Promise<void> {
  const redisKey = `idem:pay:${idempotencyKey}`;

  if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
    await executeUpstashCommand<number>(['DEL', redisKey]);
    return;
  }

  memoryIdempotency.delete(redisKey);
}
</file>

<file path="lib/services/inactivityManager.ts">
/**
 * @name InactivityManager
 * @description [Business Logic & Orchestration]: Manages conversation session timeouts and warning notifications
 * for the Rendy WhatsApp interface.
 *
 * Requirements:
 * 1. 2-Minute Inactivity Warning: When 2 minutes have elapsed without user interaction, notifies the user
 *    that their session will automatically close in 1 minute due to inactivity (reaching the 3-minute limit).
 * 2. 3-Minute Expiration: Closes the session if no activity occurs for 3 minutes, resetting state to 'INICIO'
 *    and sending the main navigation menu.
 * 3. Proactive In-Memory Timers: Uses high-precision Node.js timeouts for instantaneous real-time execution.
 * 4. Database-Backed Fallback: Idempotently tracks `aviso_inactividad_enviado` and `ultima_interaccion` to allow
 *    cron/worker invocations without duplicate notifications.
 */

import { SupabaseClient } from '@supabase/supabase-js';
import {
  enviarMensajeWhatsApp,
  enviarBotonesWhatsApp,
  enviarMenuPrincipalListMessage,
} from '@/app/lib/whatsapp';
import type { DatosTemporalesSesion, SesionWhatsAppRecord } from '@/lib/types/whatsapp';

/**
 * Inactivity warning window: 2 minutes in milliseconds.
 */
export const INACTIVITY_WARNING_MS = 2 * 60 * 1000; // 120,000 ms (2 minutes)

/**
 * Total inactivity expiration window: 3 minutes in milliseconds.
 */
export const INACTIVITY_EXPIRATION_MS = 3 * 60 * 1000; // 180,000 ms (3 minutes)

interface ActiveSessionTimers {
  warningTimer: NodeJS.Timeout;
  expirationTimer: NodeJS.Timeout;
  scheduledAt: number;
}

/**
 * In-memory map of active session timers indexed by normalized phone number.
 */
const activeTimersStore = new Map<string, ActiveSessionTimers>();

export interface ScheduleTimersParams {
  supabase: SupabaseClient;
  telefono: string;
  empleadoId?: string | null;
  employeeName?: string;
}

/**
 * @name clearInactivityTimers
 * @description [Resource Hygiene]: Clears any pending warning and expiration timers for a phone number.
 */
export function clearInactivityTimers(telefono: string): void {
  const existing = activeTimersStore.get(telefono);
  if (existing) {
    clearTimeout(existing.warningTimer);
    clearTimeout(existing.expirationTimer);
    activeTimersStore.delete(telefono);
  }
}

/**
 * @name scheduleInactivityTimers
 * @description [Business Logic]: Schedules proactive 2-minute warning and 3-minute expiration timers
 * for an active conversation flow.
 */
export function scheduleInactivityTimers({
  supabase,
  telefono,
  empleadoId,
  employeeName,
}: ScheduleTimersParams): void {
  // Clear any existing timer for this phone before setting new ones
  clearInactivityTimers(telefono);

  // 1. Warning timer at 2 minutes (120,000 ms)
  const warningTimer = setTimeout(async () => {
    try {
      await executeInactivityWarning(supabase, telefono);
    } catch (error) {
      console.error(`❌ Error executing 2-minute inactivity warning for ${telefono}:`, error);
    }
  }, INACTIVITY_WARNING_MS);

  // 2. Expiration timer at 3 minutes (180,000 ms)
  const expirationTimer = setTimeout(async () => {
    try {
      await executeSessionExpiration(supabase, telefono, empleadoId, employeeName);
    } catch (error) {
      console.error(`❌ Error executing 3-minute session expiration for ${telefono}:`, error);
    }
  }, INACTIVITY_EXPIRATION_MS);

  activeTimersStore.set(telefono, {
    warningTimer,
    expirationTimer,
    scheduledAt: Date.now(),
  });
}

/**
 * @name executeInactivityWarning
 * @description [Business Logic]: Sends the 2-minute warning message informing the employee
 * that the session will close in 1 minute unless kept active.
 */
async function executeInactivityWarning(
  supabase: SupabaseClient,
  telefono: string
): Promise<boolean> {
  const { data: sesionData, error } = await supabase
    .from('sesiones_whatsapp')
    .select('*')
    .eq('telefono', telefono)
    .maybeSingle();

  if (error || !sesionData) return false;

  const sesion = sesionData as SesionWhatsAppRecord;

  // Only warn if the session is currently active in a non-initial state
  if (sesion.estado === 'INICIO') {
    clearInactivityTimers(telefono);
    return false;
  }

  const elapsedMs = Date.now() - new Date(sesion.ultima_interaccion).getTime();

  // If user interacted recently, don't send warning
  if (elapsedMs < 115_000) {
    return false;
  }

  // If warning was already sent, do not duplicate
  if (sesion.datos_temporales?.aviso_inactividad_enviado) {
    return false;
  }

  const avisoTexto =
    '⚠️ *Aviso de Inactividad*\n\n' +
    'Han transcurrido 2 minutos sin actividad. En *1 minuto* se cerrará tu sesión automáticamente por inactividad (al cumplirse los 3 minutos permitidos).\n\n' +
    '¿Deseas continuar con tu gestión?';

  await enviarBotonesWhatsApp(
    telefono,
    avisoTexto,
    [
      { id: 'BTN_MANTENER_SESION', title: 'Continuar gestión' },
      { id: 'VOLVER_MENU', title: '⬅️ Cancelar gestión' },
    ],
    'Control de Tiempo Rendy'
  );

  // Persist that the warning was dispatched so it won't be repeated
  const datosActualizados: DatosTemporalesSesion = {
    ...(sesion.datos_temporales || {}),
    aviso_inactividad_enviado: true,
  };

  await supabase
    .from('sesiones_whatsapp')
    .update({
      datos_temporales: datosActualizados as unknown as Record<string, unknown>,
    })
    .eq('telefono', telefono);

  return true;
}

/**
 * @name executeSessionExpiration
 * @description [Business Logic]: Expires the session at 3 minutes of inactivity, resets DB state to 'INICIO',
 * delivers the closure notice, and re-presents the main menu.
 */
async function executeSessionExpiration(
  supabase: SupabaseClient,
  telefono: string,
  empleadoId?: string | null,
  employeeName?: string
): Promise<boolean> {
  const { data: sesionData, error } = await supabase
    .from('sesiones_whatsapp')
    .select('*')
    .eq('telefono', telefono)
    .maybeSingle();

  if (error || !sesionData) {
    clearInactivityTimers(telefono);
    return false;
  }

  const sesion = sesionData as SesionWhatsAppRecord;

  if (sesion.estado === 'INICIO') {
    clearInactivityTimers(telefono);
    return false;
  }

  const elapsedMs = Date.now() - new Date(sesion.ultima_interaccion).getTime();

  // If user interacted recently, do not expire
  if (elapsedMs < 175_000) {
    return false;
  }

  // 1. Reset session in database
  await supabase.from('sesiones_whatsapp').upsert({
    telefono,
    empleado_id: empleadoId || sesion.empleado_id || null,
    estado: 'INICIO',
    datos_temporales: null,
    ultima_interaccion: new Date().toISOString(),
  });

  // 2. Clear timer references
  clearInactivityTimers(telefono);

  // 3. Send timeout notification
  await enviarMensajeWhatsApp(
    telefono,
    '⏱️ *Sesión cerrada por inactividad.*\n\nSe han cumplido los 3 minutos de inactividad y tu gestión anterior fue cancelada por seguridad.'
  );

  // 4. Send main navigation menu
  let resolvedName = employeeName;
  if (!resolvedName && (empleadoId || sesion.empleado_id)) {
    const { data: usr } = await supabase
      .from('usuarios')
      .select('nombre')
      .eq('id', empleadoId || sesion.empleado_id)
      .maybeSingle();
    resolvedName = usr?.nombre;
  }
  await enviarMenuPrincipalListMessage(telefono, resolvedName);

  return true;
}

/**
 * @name checkInactiveSessions
 * @description [Cron/Worker]: Scans all open sessions in `sesiones_whatsapp` to enforce 2-minute warnings
 * and 3-minute expirations. Can be triggered periodically by serverless cron jobs or health check tasks.
 */
export async function checkInactiveSessions(
  supabase: SupabaseClient
): Promise<{ warned: number; expired: number }> {
  const { data: sesiones, error } = await supabase
    .from('sesiones_whatsapp')
    .select('telefono, empleado_id, estado, datos_temporales, ultima_interaccion')
    .neq('estado', 'INICIO');

  if (error || !sesiones || sesiones.length === 0) {
    return { warned: 0, expired: 0 };
  }

  const now = Date.now();
  let warnedCount = 0;
  let expiredCount = 0;

  for (const item of sesiones) {
    const sesion = item as SesionWhatsAppRecord;
    const elapsed = now - new Date(sesion.ultima_interaccion).getTime();

    // 1. Expiration check (>= 3 minutes)
    if (elapsed >= INACTIVITY_EXPIRATION_MS) {
      const expired = await executeSessionExpiration(supabase, sesion.telefono, sesion.empleado_id);
      if (expired) expiredCount++;
    }
    // 2. Warning check (>= 2 minutes and warning not yet sent)
    else if (elapsed >= INACTIVITY_WARNING_MS && !sesion.datos_temporales?.aviso_inactividad_enviado) {
      const warned = await executeInactivityWarning(supabase, sesion.telefono);
      if (warned) warnedCount++;
    }
  }

  return { warned: warnedCount, expired: expiredCount };
}
</file>

<file path="lib/services/notificacionesReembolso.ts">
/**
 * @name NotificacionesReembolsoService
 * @description [Business Logic]: Dispatches automated WhatsApp transactional notifications
 * to employees upon changes in their expense reimbursement lifecycle (PROCESADO, TRANSFERIDO, RECHAZADO).
 * Complies with international multi-currency rules, formatting amounts accurately according to the original currency.
 */

import { enviarMensajeWhatsApp } from '@/app/lib/whatsapp';

export type TipoNotificacionReembolso = 'PROCESADO' | 'TRANSFERIDO' | 'RECHAZADO';

export interface EnviarNotificacionReembolsoParams {
  telefono: string;
  nombreEmpleado: string;
  tipo: TipoNotificacionReembolso;
  comercio: string;
  montoUsd: number;
  monedaOriginal?: string;
  montoOriginal?: number;
  montoVes?: number;
  fechaTransferencia?: string;
  motivoRechazo?: string;
}

/**
 * @name formatNotificationAmount
 * @description [Business Logic]: Formats the amount string respecting international multi-currency rules.
 * Does not compare foreign currencies to VES, comparing only to USD.
 */
function formatNotificationAmount(
  montoUsd: number,
  monedaOriginal?: string,
  montoOriginal?: number,
  montoVes?: number
): string {
  const moneda = (monedaOriginal || 'USD').toUpperCase();
  const formatNum = (val: number) =>
    val.toLocaleString('es-VE', { minimumFractionDigits: 2, maximumFractionDigits: 2 });

  if (moneda === 'VES') {
    const ves = montoVes && montoVes > 0 ? montoVes : (montoOriginal || 0);
    return `*${formatNum(ves)} Bs* (equiv. $${formatNum(montoUsd)} USD)`;
  }

  if (moneda === 'USD') {
    return `*$${formatNum(montoUsd)} USD*`;
  }

  // Any other international currency (MXN, COP, EUR, etc.)
  const nominal = montoOriginal && montoOriginal > 0 ? montoOriginal : montoUsd;
  return `*${formatNum(nominal)} ${moneda}* (equiv. $${formatNum(montoUsd)} USD)`;
}

/**
 * @name enviarNotificacionWhatsAppReembolso
 * @description [Business Logic]: Sends an automated, formatted WhatsApp notification to the employee
 * detailing the status change of their expense reimbursement claim.
 */
export async function enviarNotificacionWhatsAppReembolso({
  telefono,
  nombreEmpleado,
  tipo,
  comercio,
  montoUsd,
  monedaOriginal,
  montoOriginal,
  montoVes,
  fechaTransferencia,
  motivoRechazo,
}: EnviarNotificacionReembolsoParams): Promise<{ success: boolean; data?: unknown }> {
  try {
    if (!telefono) {
      console.warn('⚠️ [NotificacionesReembolso] Cannot send WhatsApp: missing phone number.');
      return { success: false };
    }

    const textoMonto = formatNotificationAmount(montoUsd, monedaOriginal, montoOriginal, montoVes);
    const primerNombre = nombreEmpleado.trim().split(/\s+/)[0] || 'colaborador';
    let mensaje = '';

    switch (tipo) {
      case 'PROCESADO':
        mensaje =
          `✅ *Reembolso Aprobado*\n\n` +
          `Hola ${primerNombre}, tu comprobante en *${comercio}* por ${textoMonto} ha sido validado contablemente.\n\n` +
          `⏳ Tu pago se encuentra en cola de transferencia. Te notificaremos por aquí en cuanto sea emitido.`;
        break;

      case 'TRANSFERIDO': {
        const fechaTxt = fechaTransferencia
          ? new Date(fechaTransferencia).toLocaleDateString('es-VE', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
            })
          : new Date().toLocaleDateString('es-VE', {
              day: '2-digit',
              month: '2-digit',
              year: 'numeric',
            });

        mensaje =
          `💸 *¡Reembolso Transferido!*\n\n` +
          `Hola ${primerNombre}, se ha realizado con éxito la transferencia de tu reembolso:\n` +
          `• *Comercio:* ${comercio}\n` +
          `• *Monto Pagado:* ${textoMonto}\n` +
          `• *Fecha:* ${fechaTxt}\n\n` +
          `📎 Puedes ingresar a la plataforma web para revisar el comprobante bancario de la transacción.`;
        break;
      }

      case 'RECHAZADO':
        mensaje =
          `❌ *Reembolso No Aprobado*\n\n` +
          `Hola ${primerNombre}, tu comprobante en *${comercio}* por ${textoMonto} ha sido rechazado.\n\n` +
          `📝 *Motivo del rechazo:*\n"${motivoRechazo || 'Comprobante no cumple con las políticas fiscales requeridas.'}"\n\n` +
          `Por favor comunícate con el departamento de administración si requieres corregir este registro.`;
        break;
    }

    const res = await enviarMensajeWhatsApp(telefono, mensaje);
    return { success: true, data: res };
  } catch (error) {
    console.error('❌ [NotificacionesReembolso] Error sending WhatsApp notification:', error);
    return { success: false };
  }
}
</file>

<file path="lib/services/tasaCambio.ts">
/**
 * @name TasaCambioService
 * @description [Business Logic]: Servicio interno para consultar las tasas oficiales de cambio.
 * Reutiliza el proveedor de tasas ya existente en el proyecto (`@/lib/currency.ts`) sin
 * añadir ninguna dependencia ni API externa adicional, cumpliendo con la regla de arquitectura.
 */

import { getExchangeRates } from '@/lib/currency';

/**
 * @name obtenerTasaOficialDelDia
 * @description [Business Logic]: Retorna la tasa oficial vigente (Bs/USD) para una fecha dada.
 * Utiliza el pool de tasas existente en `lib/currency.ts` (BCV oficial).
 *
 * @param _fechaReferencia - Fecha de emisión o referencia del comprobante (YYYY-MM-DD o ISO).
 * @returns Promesa con la tasa numérica de Bolívares por Dólar (ej. 68.50).
 */
export async function obtenerTasaOficialDelDia(_fechaReferencia?: string): Promise<number> {
  try {
    const rates = await getExchangeRates();
    if (rates?.VES && Number(rates.VES) > 0) {
      return Number(rates.VES);
    }
  } catch (error) {
    console.error('❌ [TasaCambio] Error al obtener tasa oficial:', error);
  }

  // Tasa de contingencia en caso de indisponibilidad
  return 879.12;
}
</file>


<file path="supabase/migrations/004_fiscal_breakdown_dual_currency.sql">
-- ==========================================================================
-- Migration 004: Fiscal Tax Breakdown & Dual-Currency Support
-- Sprint 2 - Bloque 1: Venezuelan Fiscal Logic
-- ==========================================================================
-- PURPOSE: Add fiscal decomposition columns (base_imponible, iva, exento, igtf)
-- and dual-currency consolidation (monto_ves, monto_usd) to the gastos table.
-- This enables SENIAT-compliant accounting and bimonetary traceability.
--
-- NOTE: This migration was applied directly in Supabase. This file serves as
-- a version-controlled reference for the schema changes.
-- ==========================================================================

ALTER TABLE gastos
  -- Currency & Exchange Rate Metadata
  ADD COLUMN IF NOT EXISTS moneda_original VARCHAR(3) DEFAULT 'VES',
  ADD COLUMN IF NOT EXISTS tasa_cambio NUMERIC(12,4),
  ADD COLUMN IF NOT EXISTS origen_tasa VARCHAR(20) DEFAULT 'sistema',

  -- Fiscal Tax Breakdown in Bolívares (Legal Fiscal Currency)
  ADD COLUMN IF NOT EXISTS base_imponible_ves NUMERIC(12,2) DEFAULT 0.00,
  ADD COLUMN IF NOT EXISTS iva_ves NUMERIC(12,2) DEFAULT 0.00,
  ADD COLUMN IF NOT EXISTS exento_ves NUMERIC(12,2) DEFAULT 0.00,
  ADD COLUMN IF NOT EXISTS igtf_ves NUMERIC(12,2) DEFAULT 0.00,
  ADD COLUMN IF NOT EXISTS monto_ves NUMERIC(12,2) DEFAULT 0.00,

  -- USD Consolidation (Internal Control Currency)
  ADD COLUMN IF NOT EXISTS monto_usd NUMERIC(12,2) DEFAULT 0.00,

  -- Audit Flags
  ADD COLUMN IF NOT EXISTS requiere_revision_fiscal BOOLEAN DEFAULT FALSE;

-- Add comments for documentation
COMMENT ON COLUMN gastos.moneda_original IS 'Original currency of the invoice: VES or USD';
COMMENT ON COLUMN gastos.origen_tasa IS 'Source of the exchange rate: factura (printed on invoice) or sistema (BCV official rate)';
COMMENT ON COLUMN gastos.base_imponible_ves IS 'Tax base amount in VES (goods/services subject to IVA)';
COMMENT ON COLUMN gastos.iva_ves IS 'IVA 16% amount in VES';
COMMENT ON COLUMN gastos.exento_ves IS 'Tax-exempt amount in VES';
COMMENT ON COLUMN gastos.igtf_ves IS 'IGTF 3% amount in VES (large financial transactions tax)';
COMMENT ON COLUMN gastos.monto_ves IS 'Total invoice amount in VES';
COMMENT ON COLUMN gastos.monto_usd IS 'Total invoice amount in USD';
COMMENT ON COLUMN gastos.requiere_revision_fiscal IS 'Flag: true if fiscal breakdown does not match total (discrepancy > 0.05)';
</file>

<file path="supabase/migrations/005_viaticos_engine.sql">
-- ==========================================================================
-- Migration 005: Viáticos Engine — Budget Allocations & Gastos Imputation
-- Sprint 2 - Bloque 2: Operational Viáticos Model + Dual Routing
-- ==========================================================================
-- PURPOSE: Create the `viaticos` table for per-project budget allocations
-- and add imputation columns (`viatico_id`, `es_reembolso`) to `gastos`.
-- Also ensures `sesiones_whatsapp` has `empleado_id` for stateful sessions.
--
-- NOTE: The FK `empleado_id` references `usuarios(id)` (custom table),
-- NOT `auth.users(id)`, since Rendy uses its own user management layer.
-- ==========================================================================

-- 1. Viáticos / Budget Allocations per Project
CREATE TABLE IF NOT EXISTS viaticos (
  id                  UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  empleado_id         UUID NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
  empresa_id          UUID NOT NULL REFERENCES empresas(id) ON DELETE CASCADE,
  nombre_proyecto     VARCHAR(100) NOT NULL,
  proyecto_id         UUID REFERENCES proyectos(id) ON DELETE SET NULL,
  monto_asignado_usd  NUMERIC(12,2) NOT NULL CHECK (monto_asignado_usd > 0),
  estado              VARCHAR(30) NOT NULL DEFAULT 'PENDIENTE_APROBACION',
  fecha_inicio        DATE DEFAULT CURRENT_DATE,
  fecha_cierre        DATE,
  creado_en           TIMESTAMPTZ DEFAULT NOW(),
  actualizado_en      TIMESTAMPTZ DEFAULT NOW()
);

COMMENT ON TABLE viaticos IS 'Active budget allocations per employee/project. Tracks assigned USD amount and lifecycle state.';
COMMENT ON COLUMN viaticos.estado IS 'PENDIENTE_APROBACION | ACTIVO | CERRADO | RECHAZADO';
COMMENT ON COLUMN viaticos.monto_asignado_usd IS 'Total budget assigned to this viático in USD';

-- 2. Imputation & Reimbursement columns on gastos
ALTER TABLE gastos
  ADD COLUMN IF NOT EXISTS viatico_id    UUID REFERENCES viaticos(id) ON DELETE SET NULL,
  ADD COLUMN IF NOT EXISTS es_reembolso  BOOLEAN DEFAULT FALSE;

COMMENT ON COLUMN gastos.viatico_id IS 'FK to the viático budget this expense is charged against (NULL = reimbursement)';
COMMENT ON COLUMN gastos.es_reembolso IS 'True if the employee paid with personal funds (reimbursement flow)';

-- 3. Ensure sesiones_whatsapp has empleado_id for session identity
ALTER TABLE sesiones_whatsapp
  ADD COLUMN IF NOT EXISTS empleado_id UUID REFERENCES usuarios(id) ON DELETE CASCADE;

-- 4. Performance Indexes
CREATE INDEX IF NOT EXISTS idx_viaticos_empleado_estado
  ON viaticos (empleado_id, estado);

CREATE INDEX IF NOT EXISTS idx_gastos_viatico_acumulado
  ON gastos (viatico_id, estado)
  WHERE viatico_id IS NOT NULL;

CREATE INDEX IF NOT EXISTS idx_sesiones_whatsapp_ultima
  ON sesiones_whatsapp (ultima_interaccion);

-- 5. RLS Policies for viaticos
ALTER TABLE viaticos ENABLE ROW LEVEL SECURITY;

CREATE POLICY "Full access service role on viaticos"
  ON viaticos
  FOR ALL
  USING (true)
  WITH CHECK (true);

-- ==========================================================================
-- DONE — Execute this script once in Supabase SQL Editor.
-- ==========================================================================
</file>

<file path="supabase/migrations/006_reembolsos_module.sql">
-- ==========================================================================
-- Migration 006: Corporate Reimbursements Lifecycle & Dashboard Optimization
-- ==========================================================================
-- PURPOSE:
-- 1. Standardize reimbursement lifecycle states in `estado_gasto` enum:
--    - 'PROCESADO': Validated by accounting, ready for transfer/payment.
--    - 'TRANSFERIDO': Payment issued and settled with the employee.
-- 2. Add `actualizado_en` audit timestamp to `gastos` table.
-- 3. Create a partial index for multi-tenant reimbursement queries in the dashboard.
-- ==========================================================================

-- 1. Extend enum `estado_gasto` with reimbursement settlement statuses
ALTER TYPE estado_gasto ADD VALUE IF NOT EXISTS 'PROCESADO';
ALTER TYPE estado_gasto ADD VALUE IF NOT EXISTS 'TRANSFERIDO';

-- 2. Add audit column for updates
ALTER TABLE gastos
  ADD COLUMN IF NOT EXISTS actualizado_en TIMESTAMPTZ DEFAULT NOW();

-- 3. Composite partial index for multi-tenant reimbursement dashboard queries
CREATE INDEX IF NOT EXISTS idx_gastos_reembolsos_dashboard 
  ON gastos (empresa_id, es_reembolso, estado, fecha_gasto DESC) 
  WHERE es_reembolso = TRUE;
</file>

<file path="supabase/migrations/007_reembolsos_transfer_support.sql">
-- ==========================================================================
-- Migration 007: Reimbursement Transfer Proof & Audit Support
-- ==========================================================================
-- PURPOSE:
-- 1. Add `url_comprobante_pago`, `fecha_transferencia`, and `transferido_por`
--    columns to `gastos` table to persist bank transfer settlements.
-- 2. Ensure `comprobantes_pago` storage bucket exists.
-- 3. Synchronize legacy personal expenses so they are tracked as reimbursements.
-- ==========================================================================

ALTER TABLE gastos
  ADD COLUMN IF NOT EXISTS url_comprobante_pago TEXT DEFAULT NULL,
  ADD COLUMN IF NOT EXISTS fecha_transferencia TIMESTAMPTZ DEFAULT NULL,
  ADD COLUMN IF NOT EXISTS transferido_por UUID REFERENCES usuarios(id) ON DELETE SET NULL;

INSERT INTO storage.buckets (id, name, public)
VALUES ('comprobantes_pago', 'comprobantes_pago', true)
ON CONFLICT (id) DO NOTHING;

-- Synchronize legacy personal expenses without viático / corporate payment method
UPDATE gastos
SET es_reembolso = TRUE
WHERE viatico_id IS NULL
  AND solicitud_id IS NULL
  AND metodo_pago_id IS NULL
  AND es_reembolso IS NOT TRUE;
</file>

<file path="supabase/migrations/008_reportes_generados.sql">
-- ==========================================================================
-- Migration 008: Accounting Reports Generation & Audit History
-- ==========================================================================
-- PURPOSE:
-- 1. Create table `reportes_generados` to audit and log all exported financial
--    reports (Excel/PDF) per company, tracking applied filters, totals, and metadata.
-- 2. Add high-performance composite index for dashboard history lookup.
-- ==========================================================================

CREATE TABLE IF NOT EXISTS reportes_generados (
  id UUID PRIMARY KEY DEFAULT gen_random_uuid(),
  empresa_id UUID NOT NULL REFERENCES empresas(id) ON DELETE CASCADE,
  usuario_id UUID NOT NULL REFERENCES usuarios(id) ON DELETE CASCADE,
  nombre_reporte VARCHAR(150) NOT NULL,
  formato VARCHAR(10) NOT NULL DEFAULT 'XLSX',
  filtros_aplicados JSONB NOT NULL DEFAULT '{}'::jsonb,
  total_gastos_incluidos INT DEFAULT 0,
  monto_total_usd NUMERIC(12,2) DEFAULT 0.00,
  monto_total_ves NUMERIC(12,2) DEFAULT 0.00,
  url_archivo TEXT,
  creado_en TIMESTAMPTZ DEFAULT NOW()
);

-- Fast lookup index for company reports ordered chronologically
CREATE INDEX IF NOT EXISTS idx_reportes_empresa_fecha 
  ON reportes_generados (empresa_id, creado_en DESC);

-- Document table and columns
COMMENT ON TABLE reportes_generados IS 'Audit log of generated accounting reports and exported spreadsheets';
COMMENT ON COLUMN reportes_generados.nombre_reporte IS 'Human readable title of the report (e.g. Reporte_Gastos_2026-11)';
COMMENT ON COLUMN reportes_generados.formato IS 'File format of the export: XLSX or PDF';
COMMENT ON COLUMN reportes_generados.filtros_aplicados IS 'JSON snapshot of the filter parameters used during report generation';
COMMENT ON COLUMN reportes_generados.total_gastos_incluidos IS 'Number of expense line-items included in the report';
COMMENT ON COLUMN reportes_generados.monto_total_usd IS 'Aggregated total in USD at the time of export';
COMMENT ON COLUMN reportes_generados.monto_total_ves IS 'Aggregated total in VES at the time of export';
</file>


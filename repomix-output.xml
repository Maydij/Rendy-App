          <div
            style={{
              fontSize: '11px',
              color: '#64748b',
              fontWeight: 600,
              marginTop: '3px',
            }}
          >
            OCR Verificado Rendy IA • Tasa Fiscal Congelada
          </div>
        </div>

        {/* Main Amount */}
        <div style={{ textAlign: 'center', marginBottom: '18px' }}>
          <div
            style={{
              fontSize: '11px',
              fontWeight: 600,
              color: '#64748b',
              textTransform: 'uppercase',
              letterSpacing: '0.05em',
            }}
          >

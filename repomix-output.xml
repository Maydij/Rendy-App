const SENSITIVE_KEY_PATTERN =
  /password|token|secret|cedula|rif|card|cvv|cvc|pan|authorization|cookie|whatsapp|phone|email|mfa/i;

/**
 * @name redactSensitiveData
 * @description [Security]: Recursively traverses structured log metadata and masks
 * all PII and cryptographic secrets before writing to stdout or external log aggregators.
 */
function redactSensitiveData(value: unknown, depth = 0): unknown {
  if (depth > 6 || value === null || value === undefined) return value;

  if (typeof value === 'string') {
    if (value.length > 16 && /^[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+\.[A-Za-z0-9\-_]+$/.test(value)) {
      return '[REDACTED_JWT]';
    }
    return value;
  }

  if (Array.isArray(value)) {
    return value.map((item) => redactSensitiveData(item, depth + 1));
  }

  if (typeof value === 'object') {
    const cleanRecord: Record<string, unknown> = {};
    for (const [key, nestedVal] of Object.entries(value as Record<string, unknown>)) {
      if (SENSITIVE_KEY_PATTERN.test(key)) {
        cleanRecord[key] = '[REDACTED]';
      } else {
        cleanRecord[key] = redactSensitiveData(nestedVal, depth + 1);
      }
    }
    return cleanRecord;
  }

  return value;
}

/**
 * @name securityLogger
 * @description [Business Logic]: Tamper-evident structured logger guaranteeing zero PII leakage
 * across authentication, onboarding, and payment operations.
 */
export const securityLogger = {
  info(event: string, context?: Record<string, unknown>): void {
    console.info(
      JSON.stringify({
        level: 'INFO',
        timestamp: new Date().toISOString(),
        event,
        context: context ? redactSensitiveData(context) : undefined,
      })
    );
  },

  warn(event: string, context?: Record<string, unknown>): void {
    console.warn(
      JSON.stringify({
        level: 'WARN',
        timestamp: new Date().toISOString(),
        event,
        context: context ? redactSensitiveData(context) : undefined,
      })
    );
  },

  error(event: string, error: unknown, context?: Record<string, unknown>): void {
    let safeError: Record<string, unknown> = { message: 'Unknown runtime error' };

    if (error instanceof Error) {
      safeError = { name: error.name, message: error.message };
    } else if (typeof error === 'object' && error !== null) {
      const errObj = error as Record<string, unknown>;
      safeError = {
        code: typeof errObj.code === 'string' ? errObj.code : undefined,
        message: typeof errObj.message === 'string' ? errObj.message : 'Database or service error',
        hint: typeof errObj.hint === 'string' ? errObj.hint : undefined,
      };
    }

    console.error(
      JSON.stringify({
        level: 'ERROR',
        timestamp: new Date().toISOString(),
        event,
        error: safeError,
        context: context ? redactSensitiveData(context) : undefined,
      })
    );
  },
};
</file>

<file path="lib/security/redis-guard.ts">
import { serverEnv } from './env';

export interface RateLimitConfig {
  bucketPrefix: string;
  maxRequests: number;
  windowSeconds: number;
}

export interface RateLimitVerdict {
  allowed: boolean;
  remaining: number;
  retryAfterSeconds: number;
}

export const RATE_LIMIT_POLICIES = {
  AUTH_STRICT: {
    bucketPrefix: 'rl:auth',
    maxRequests: 5,
    windowSeconds: 15 * 60, // 5 attempts per 15 minutes
  },
  PAYMENT_STRICT: {
    bucketPrefix: 'rl:pay',
    maxRequests: 3,
    windowSeconds: 60, // 3 requests per minute
  },
  ONBOARDING_STEP: {
    bucketPrefix: 'rl:onboard',
    maxRequests: 20,
    windowSeconds: 10 * 60, // 20 step saves per 10 minutes
  },
} as const satisfies Record<string, RateLimitConfig>;

// In-memory fallback store used strictly when Redis is not configured in local dev
const memoryCounters = new Map<string, { count: number; expiresAt: number }>();
const memoryIdempotency = new Map<string, { payload: string; expiresAt: number }>();

/**
 * @name executeUpstashCommand
 * @description [Infrastructure]: Dispatches atomic REST commands to Upstash Redis.
 */
async function executeUpstashCommand<T>(commandParts: (string | number)[]): Promise<T | null> {
  const url = serverEnv.UPSTASH_REDIS_REST_URL;
  const token = serverEnv.UPSTASH_REDIS_REST_TOKEN;
  if (!url || !token) return null;

  const response = await fetch(url, {
    method: 'POST',
    headers: {
      Authorization: `Bearer ${token}`,
      'Content-Type': 'application/json',
    },
    body: JSON.stringify(commandParts),
    cache: 'no-store',
  });

  if (!response.ok) {
    throw new Error(`Redis command failed with status ${response.status}`);
  }

  const json = (await response.json()) as { result: T };
  return json.result;
}

/**
 * @name enforceRateLimit
 * @description [Business Logic]: Enforces distributed sliding/fixed-window rate limiting
 * across authentication, payment, and onboarding endpoints to neutralize brute-force and card-testing attacks.
 */
export async function enforceRateLimit(
  identifierHash: string,
  policy: RateLimitConfig
): Promise<RateLimitVerdict> {
  const key = `${policy.bucketPrefix}:${identifierHash}`;

  try {
    if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
      const currentCount = await executeUpstashCommand<number>(['INCR', key]);
      if (currentCount === 1) {
        await executeUpstashCommand<number>(['EXPIRE', key, policy.windowSeconds]);
      }

      const ttl = (await executeUpstashCommand<number>(['TTL', key])) ?? policy.windowSeconds;
      const count = currentCount ?? 1;

      if (count > policy.maxRequests) {
        return {
          allowed: false,
          remaining: 0,
          retryAfterSeconds: Math.max(1, ttl),
        };
      }

      return {
        allowed: true,
        remaining: Math.max(0, policy.maxRequests - count),
        retryAfterSeconds: 0,
      };
    }
  } catch (error) {
    console.error('⚠️ [RedisGuard] Fallback to local rate-limit store:', error);
  }

  // Fallback deterministic counter
  const now = Date.now();
  const existing = memoryCounters.get(key);
  if (!existing || existing.expiresAt <= now) {
    memoryCounters.set(key, {
      count: 1,
      expiresAt: now + policy.windowSeconds * 1000,
    });
    return { allowed: true, remaining: policy.maxRequests - 1, retryAfterSeconds: 0 };
  }

  existing.count += 1;
  if (existing.count > policy.maxRequests) {
    return {
      allowed: false,
      remaining: 0,
      retryAfterSeconds: Math.ceil((existing.expiresAt - now) / 1000),
    };
  }

  return {
    allowed: true,
    remaining: policy.maxRequests - existing.count,
    retryAfterSeconds: 0,
  };
}

/**
 * @name acquireIdempotencyLock
 * @description [Business Logic]: Atomically claims a UUIDv4 Idempotency-Key in Redis (`SETNX` with 24h TTL)
 * so concurrent or retried payment/subscription requests never execute duplicate Stripe charges.
 */
export async function acquireIdempotencyLock(
  idempotencyKey: string
): Promise<{ acquired: boolean; cachedResponse?: string }> {
  const redisKey = `idem:pay:${idempotencyKey}`;
  const ttlSeconds = 24 * 60 * 60; // 24 hours

  if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
    const setResult = await executeUpstashCommand<string | null>([
      'SET',
      redisKey,
      'IN_PROGRESS',
      'NX',
      'EX',
      ttlSeconds,
    ]);

    if (setResult === 'OK') {
      return { acquired: true };
    }

    const existingValue = await executeUpstashCommand<string | null>(['GET', redisKey]);
    return {
      acquired: false,
      cachedResponse: existingValue && existingValue !== 'IN_PROGRESS' ? existingValue : undefined,
    };
  }

  const now = Date.now();
  const existing = memoryIdempotency.get(redisKey);
  if (existing && existing.expiresAt > now) {
    return {
      acquired: false,
      cachedResponse: existing.payload !== 'IN_PROGRESS' ? existing.payload : undefined,
    };
  }

  memoryIdempotency.set(redisKey, {
    payload: 'IN_PROGRESS',
    expiresAt: now + ttlSeconds * 1000,
  });
  return { acquired: true };
}

/**
 * @name storeIdempotencyResult
 * @description [Business Logic]: Persists the finalized JSON response for an Idempotency-Key
 * for 24 hours so safe retries receive the exact original result.
 */
export async function storeIdempotencyResult(
  idempotencyKey: string,
  serializedPayload: string
): Promise<void> {
  const redisKey = `idem:pay:${idempotencyKey}`;
  const ttlSeconds = 24 * 60 * 60;

  if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
    await executeUpstashCommand<string>(['SET', redisKey, serializedPayload, 'EX', ttlSeconds]);
    return;
  }

  memoryIdempotency.set(redisKey, {
    payload: serializedPayload,
    expiresAt: Date.now() + ttlSeconds * 1000,
  });
}

/**
 * @name releaseIdempotencyLock
 * @description [Business Logic]: Releases an in-progress Idempotency-Key lock when an
 * upstream payment initialization fails prior to creating a charge or subscription,
 * allowing safe retries without triggering HTTP 409 Conflict.
 */
export async function releaseIdempotencyLock(idempotencyKey: string): Promise<void> {
  const redisKey = `idem:pay:${idempotencyKey}`;

  if (serverEnv.UPSTASH_REDIS_REST_URL && serverEnv.UPSTASH_REDIS_REST_TOKEN) {
    await executeUpstashCommand<number>(['DEL', redisKey]);
    return;
  }

  memoryIdempotency.delete(redisKey);
}
</file>

<file path="lib/security/session.ts">
import crypto from 'node:crypto';
import { cookies } from 'next/headers';
import { SignJWT, jwtVerify, type JWTPayload } from 'jose';
import { supabaseServer } from '@/lib/supabase-server';
import { serverEnv } from './env';
import { generateCryptographicToken, hashSha256 } from './crypto';
import { securityLogger } from './logger';

export const ACCESS_COOKIE_NAME = 'rendy_access_token';
export const REFRESH_COOKIE_NAME = 'rendy_refresh_token';

const ACCESS_TOKEN_TTL_SECONDS = 15 * 60; // 15 minutes
const REFRESH_TOKEN_TTL_SECONDS = 7 * 24 * 60 * 60; // 7 days
const PKCS8_ED25519_PREFIX = Buffer.from('302e020100300506032b657004220420', 'hex');

export type UserRole = 'ADMIN' | 'EMPLOYEE';

export interface AuthenticatedSessionPayload {
  userId: string;
  empresaId: string;
  role: UserRole;
  familyId: string;
}

interface Ed25519KeyPair {
  privateKey: crypto.KeyObject;
  publicKey: crypto.KeyObject;
}

let cachedKeyPair: Ed25519KeyPair | null = null;

/**
 * @name getEd25519KeyPair
 * @description [Security]: Deterministically derives an asymmetric Ed25519 key pair from the
 * server signing secret so short-lived Access Tokens are signed with EdDSA (never HS256).
 */
function getEd25519KeyPair(): Ed25519KeyPair {
  if (cachedKeyPair) return cachedKeyPair;

  const seed = crypto.createHash('sha256').update(serverEnv.SESSION_SIGNING_SECRET).digest();
  const privateKey = crypto.createPrivateKey({
    key: Buffer.concat([PKCS8_ED25519_PREFIX, seed]),
    format: 'der',
    type: 'pkcs8',
  });
  const publicKey = crypto.createPublicKey(privateKey);

  cachedKeyPair = { privateKey, publicKey };
  return cachedKeyPair;
}

/**
 * @name signAccessToken
 * @description [Business Logic]: Issues a 15-minute EdDSA (Ed25519) JWT containing the
 * authenticated user's tenant ID (`empresaId`) and RBAC role (`ADMIN` or `EMPLOYEE`).
 */
export async function signAccessToken(payload: AuthenticatedSessionPayload): Promise<string> {
  const { privateKey } = getEd25519KeyPair();

  return new SignJWT({
    empresaId: payload.empresaId,
    role: payload.role,
    familyId: payload.familyId,
  })
    .setProtectedHeader({ alg: 'EdDSA', typ: 'JWT' })
    .setSubject(payload.userId)
    .setIssuer('rendy-auth')
    .setAudience('rendy-platform')
    .setIssuedAt()
    .setExpirationTime(`${ACCESS_TOKEN_TTL_SECONDS}s`)
    .sign(privateKey);
}

/**
 * @name verifyAccessToken
 * @description [Security]: Verifies the asymmetric Ed25519 signature and expiration of an
 * incoming Access Token, returning the strictly typed tenant and role context.
 */
export async function verifyAccessToken(
  token: string
): Promise<AuthenticatedSessionPayload | null> {
  try {
    const { publicKey } = getEd25519KeyPair();
    const { payload } = await jwtVerify(token, publicKey, {
      algorithms: ['EdDSA'],
      issuer: 'rendy-auth',
      audience: 'rendy-platform',
    });

    return extractSessionFromJwtPayload(payload);
  } catch {
    return null;
  }
}

function extractSessionFromJwtPayload(
  payload: JWTPayload
): AuthenticatedSessionPayload | null {
  const userId = payload.sub;
  const empresaId = payload.empresaId;
  const role = payload.role;
  const familyId = payload.familyId;

  if (
    typeof userId !== 'string' ||
    typeof empresaId !== 'string' ||
    (role !== 'ADMIN' && role !== 'EMPLOYEE') ||
    typeof familyId !== 'string'
  ) {
    return null;
  }

  return { userId, empresaId, role, familyId };
}

/**
 * @name setSessionCookies
 * @description [Security]: Writes HttpOnly, SameSite=Strict, Secure cookies for both the
 * short-lived Access Token and the rotating Refresh Token.
 */
export async function setSessionCookies(
  accessToken: string,
  rawRefreshToken: string
): Promise<void> {
  const cookieStore = await cookies();
  const isSecure = serverEnv.NODE_ENV === 'production';

  cookieStore.set(ACCESS_COOKIE_NAME, accessToken, {
    httpOnly: true,
    secure: isSecure,
    sameSite: 'strict',
    path: '/',
    maxAge: ACCESS_TOKEN_TTL_SECONDS,
  });

  cookieStore.set(REFRESH_COOKIE_NAME, rawRefreshToken, {
    httpOnly: true,
    secure: isSecure,
    sameSite: 'strict',
    path: '/',
    maxAge: REFRESH_TOKEN_TTL_SECONDS,
  });
}

/**
 * @name clearSessionCookies
 * @description [Security]: Immediately expires and clears all authentication cookies on logout
 * or security revocation.
 */
export async function clearSessionCookies(): Promise<void> {
  const cookieStore = await cookies();
  const isSecure = serverEnv.NODE_ENV === 'production';

  cookieStore.set(ACCESS_COOKIE_NAME, '', {
    httpOnly: true,
    secure: isSecure,
    sameSite: 'strict',
    path: '/',
    maxAge: 0,
  });

  cookieStore.set(REFRESH_COOKIE_NAME, '', {
    httpOnly: true,
    secure: isSecure,
    sameSite: 'strict',
    path: '/',
    maxAge: 0,
  });
}

/**
 * @name createAuthenticatedSession
 * @description [Business Logic]: Creates a new Refresh Token family in PostgreSQL, signs an
 * Ed25519 Access Token, and binds both to strict HttpOnly cookies upon successful login or onboarding.
 */
export async function createAuthenticatedSession(params: {
  userId: string;
  empresaId: string;
  role: UserRole;
  ipHash: string;
  userAgentHash: string;
}): Promise<void> {
  const { rawToken: rawRefreshToken, tokenHash: refreshTokenHash } = generateCryptographicToken(48);
  const expiresAt = new Date(Date.now() + REFRESH_TOKEN_TTL_SECONDS * 1000).toISOString();

  const { data: family, error } = await supabaseServer
    .from('refresh_token_families')
    .insert({
      user_id: params.userId,
      empresa_id: params.empresaId,
      current_token_hash: refreshTokenHash,
      family_revoked: false,
      ip_hash: params.ipHash,
      user_agent_hash: params.userAgentHash,
      expires_at: expiresAt,
    })
    .select('id')
    .single();

  if (error || !family) {
    throw new Error('Failed to create refresh token family.');
  }

  const accessToken = await signAccessToken({
    userId: params.userId,
    empresaId: params.empresaId,
    role: params.role,
    familyId: family.id,
  });

  await setSessionCookies(accessToken, rawRefreshToken);
}

/**
 * @name rotateRefreshTokenSession
 * @description [Security]: Executes Refresh Token Rotation (RTR). If an already-used or revoked
 * refresh token is presented, it immediately revokes the entire token family (compromise detection)
 * and destroys the session.
 */
export async function rotateRefreshTokenSession(
  rawRefreshToken: string
): Promise<AuthenticatedSessionPayload | null> {
  const presentedHash = hashSha256(rawRefreshToken);

  const { data: family } = await supabaseServer
    .from('refresh_token_families')
    .select('id, user_id, empresa_id, family_revoked, expires_at')
    .eq('current_token_hash', presentedHash)
    .maybeSingle();

  if (!family) {
    securityLogger.warn('auth.rtr.unrecognized_or_reused_token');
    await clearSessionCookies();
    return null;
  }

  if (family.family_revoked || new Date(family.expires_at).getTime() <= Date.now()) {
    await supabaseServer
      .from('refresh_token_families')
      .update({
        family_revoked: true,
        revoked_reason: 'TOKEN_REUSE_OR_EXPIRED',
        updated_at: new Date().toISOString(),
      })
      .eq('id', family.id);

    await clearSessionCookies();
    securityLogger.warn('auth.rtr.family_revoked', { familyId: family.id });
    return null;
  }

  // Verify user is still ACTIVE
  const { data: user } = await supabaseServer
    .from('usuarios')
    .select('id, empresa_id, role, status')
    .eq('id', family.user_id)
    .single();

  if (!user || user.status !== 'ACTIVE') {
    await supabaseServer
      .from('refresh_token_families')
      .update({ family_revoked: true, revoked_reason: 'USER_INACTIVE' })
      .eq('id', family.id);
    await clearSessionCookies();
    return null;
  }

  const role = (user.role === 'ADMIN' ? 'ADMIN' : 'EMPLOYEE') as UserRole;
  const { rawToken: nextRawRefresh, tokenHash: nextRefreshHash } = generateCryptographicToken(48);

  const { error: rotateErr } = await supabaseServer
    .from('refresh_token_families')
    .update({
      current_token_hash: nextRefreshHash,
      updated_at: new Date().toISOString(),
    })
    .eq('id', family.id)
    .eq('current_token_hash', presentedHash);

  if (rotateErr) {
    await clearSessionCookies();
    return null;
  }

  const sessionPayload: AuthenticatedSessionPayload = {
    userId: user.id,
    empresaId: user.empresa_id,
    role,
    familyId: family.id,
  };

  const nextAccessToken = await signAccessToken(sessionPayload);
  await setSessionCookies(nextAccessToken, nextRawRefresh);

  return sessionPayload;
}
</file>

<file path="lib/whatsapp/employee-resolver.ts">
import { supabaseServer } from '@/lib/supabase-server';
import { computeBlindIndex } from '@/lib/security/crypto';
import type { ExpenseCategoryPermissions } from '@/app/actions/invitations.actions';

export interface ResolvedWhatsAppEmployee {
  id: string;
  empresaId: string;
  nombre: string;
  department: string | null;
  allowedCategories: ExpenseCategoryPermissions;
}

/**
 * @name resolveEmployeeByWhatsAppPhone
 * @description [Business Logic & Security]: Locates an active employee via deterministic
 * HMAC-SHA256 Blind Index lookup on their incoming WhatsApp phone number, returning their
 * multi-tenant organization ID and granular category permissions without storing plaintext phones.
 */
export async function resolveEmployeeByWhatsAppPhone(
  incomingPhone: string
): Promise<ResolvedWhatsAppEmployee | null> {
  const digits = incomingPhone.replace(/[^\d]/g, '');
  if (!digits) return null;

  const blindIndex = computeBlindIndex(digits);

  // 1. Primary lookup via encrypted Blind Index
  const { data: userByBlind } = await supabaseServer
    .from('usuarios')
    .select('id, empresa_id, nombre, department, allowed_expense_categories, status')
    .eq('whatsapp_blind_index', blindIndex)
    .eq('status', 'ACTIVE')
    .maybeSingle();

  if (userByBlind) {
    return {
      id: userByBlind.id,
      empresaId: userByBlind.empresa_id,
      nombre: userByBlind.nombre,
      department: userByBlind.department ?? null,
      allowedCategories: (userByBlind.allowed_expense_categories as ExpenseCategoryPermissions) ?? {
        ALIMENTACION: true,
        TRANSPORTE: true,
        HOSPEDAJE: true,
        REPRESENTACION: false,
        OTROS: true,
      },
    };
  }

  // 2. Legacy fallback for pre-migration records
  const { data: legacyUser } = await supabaseServer
    .from('usuarios')
    .select('id, empresa_id, nombre, department, allowed_expense_categories')
    .eq('telefono_whatsapp', digits)
    .maybeSingle();

  if (!legacyUser) return null;

  return {
    id: legacyUser.id,
    empresaId: legacyUser.empresa_id,
    nombre: legacyUser.nombre,
    department: legacyUser.department ?? null,
    allowedCategories: (legacyUser.allowed_expense_categories as ExpenseCategoryPermissions) ?? {
      ALIMENTACION: true,
      TRANSPORTE: true,
      HOSPEDAJE: true,
      REPRESENTACION: false,
      OTROS: true,
    },
  };
}

/**
 * @name isExpenseCategoryAllowedForEmployee
 * @description [Business Logic]: Enforces the administrator's category permission switches
 * when an employee submits a receipt via WhatsApp.
 */
export function isExpenseCategoryAllowedForEmployee(
  permissions: ExpenseCategoryPermissions,
  normalizedCategory: string
): boolean {
  const key = normalizedCategory.toUpperCase() as keyof ExpenseCategoryPermissions;
  if (!(key in permissions)) return Boolean(permissions.OTROS);
  return Boolean(permissions[key]);
}

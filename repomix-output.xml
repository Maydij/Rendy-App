                                </span>
                                <button
                                  type="button"
                                  onClick={() => setViewTarget(sol)}
                                  className="btn btn-ghost btn-sm"
                                  style={{ padding: '3px 8px', fontSize: '11px', display: 'inline-flex', alignItems: 'center', gap: '4px' }}

  --shadow-glow-plan: 0 0 35px color-mix(in oklab, var(--primary-container) 20%, transparent);
  --shadow-glow-cyan: 0 0 15px color-mix(in oklab, var(--secondary) 30%, transparent);
  --shadow-glow-amber: 0 0 15px color-mix(in oklab, var(--tertiary-container) 30%, transparent);
  --shadow-header: 0 1px 8px oklch(0 0 0 / 40%);

  /* shadcn semantic tokens */
  --color-background: var(--background);
  --color-foreground: var(--foreground);

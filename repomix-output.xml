                              >
                                <X size={13} /> Rechazar
                              </button>
                            </div>
                          ) : isApproved && !hasTransferProof ? (
                            <div style={{ display: 'flex', justifyContent: 'flex-end' }}>
                              <button
                                className="btn btn-ghost btn-sm"
                                style={{
                                  padding: '4px 10px',
                                  fontSize: '11px',
                                  display: 'inline-flex',
                                  alignItems: 'center',
                                  gap: '5px',
                                  color: 'var(--rendy-warning)',
                                }}
                                onClick={() => {
                                  setApproveTarget(sol);
                                  setApproveModalMode('SUBIR_COMPROBANTE');
                                }}
                              >

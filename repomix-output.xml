<file path="lib/analytics/tracking-plan.ts">
// lib/analytics/tracking-plan.ts
import { z } from 'zod';

/**
 * @name TrackingPlanSchemas
 * @description [Business Logic]: Strict Zero-PII telemetry event dictionary for RudderStack and PostHog.
 * Prevents dirty analytics data and guarantees no customer emails, names, or financial secrets leave the app.
 */
export const TrackingPlanSchemas = {
  onboarding_step_viewed: z
    .object({
      step_number: z.number().int().min(1).max(5),
      step_name: z.enum(['ACCOUNT', 'FISCAL_PROFILE', 'PLAN_SELECTION', 'CHECKOUT', 'FTUX_DASHBOARD']),
    })
    .strict(),

  onboarding_step_completed: z
    .object({
      step_number: z.number().int().min(1).max(5),
      step_name: z.enum(['ACCOUNT', 'FISCAL_PROFILE', 'PLAN_SELECTION', 'CHECKOUT', 'FTUX_DASHBOARD']),
      duration_seconds: z.number().nonnegative(),
    })
    .strict(),

  plan_recommendation_interacted: z
    .object({
      recommended_plan_id: z.string().min(1).max(40),
      selected_plan_id: z.string().min(1).max(40),
      billing_cycle: z.enum(['MONTHLY', 'ANNUAL']),
      employee_bracket: z.string().min(1).max(40),
    })
    .strict(),

  trial_checkout_initiated: z
    .object({
      plan_id: z.string().min(1).max(40),
      billing_cycle: z.enum(['MONTHLY', 'ANNUAL']),
      trial_days: z.literal(7),
    })
    .strict(),

  ftux_checklist_completed: z
    .object({
      action_type: z.enum(['ACCOUNTING_TEMPLATE', 'SCHEDULE_SETUP_CALL', 'INVITE_EMPLOYEE']),
      total_completed_count: z.number().int().min(1).max(3),
    })
    .strict(),

  feature_dwell_heartbeat: z
    .object({
      feature_key: z.enum([
        'DASHBOARD_OVERVIEW',
        'VIATICOS_MANAGEMENT',
        'GASTOS_CORPORATIVOS',
        'JUSTIFICACION',
        'REEMBOLSOS',
        'REPORTES_CONTABLES',
        'CONFIGURACION_EQUIPO',
        'EMPLOYEE_PORTAL',
      ]),
      active_seconds_delta: z.number().int().min(1).max(60),
      user_role: z.enum(['ADMIN', 'EMPLOYEE']),
    })
    .strict(),
} as const;

export type TrackingEventName = keyof typeof TrackingPlanSchemas;
export type TrackingEventPayload<K extends TrackingEventName> = z.infer<
  (typeof TrackingPlanSchemas)[K]
>;

/**
 * @name trackProductEvent
 * @description [Business Logic]: Validates product telemetry against the canonical Zod Tracking Plan
 * and dispatches sanitized events to the first-party analytics proxy (/api/t) for RudderStack/PostHog.
 */
export async function trackProductEvent<K extends TrackingEventName>(
  eventName: K,
  payload: TrackingEventPayload<K>
): Promise<void> {
  const schema = TrackingPlanSchemas[eventName];
  const parsed = schema.safeParse(payload);

  if (!parsed.success) {
    if (process.env.NODE_ENV !== 'production') {
      console.error(`❌ [TrackingPlan] Invalid payload for "${eventName}":`, parsed.error.format());
    }
    return;
  }

  try {
    if (typeof window !== 'undefined') {
      void fetch('/api/t', {
        method: 'POST',
        headers: { 'Content-Type': 'application/json' },
        body: JSON.stringify({
          event: eventName,
          properties: parsed.data,
          timestamp: new Date().toISOString(),
        }),
        keepalive: true,
      });
    }
  } catch {
    // Telemetry must never degrade user experience
  }
}
</file>

<file path="lib/billing/plans.ts">
import { z } from 'zod';

export const PlanIdSchema = z.enum(['STARTER', 'GROWTH', 'ENTERPRISE']);
export type PlanId = z.infer<typeof PlanIdSchema>;

export const BillingCycleSchema = z.enum(['MONTHLY', 'ANNUAL']);
export type BillingCycle = z.infer<typeof BillingCycleSchema>;

export interface SubscriptionPlanDefinition {
  id: PlanId;
  tier: string;
  name: string;
  tagline: string;
  minEmployees: number;
  maxEmployees: number | null;
  monthlyPriceUsd: number;
  annualMonthlyEquivalentUsd: number;
  annualTotalUsd: number;
  annualDiscountPercent: number;
  isBestSeller: boolean;
  trialDays: number;
}

/**
 * @name SUBSCRIPTION_PLANS
 * @description [Business Logic]: Canonical server-side pricing authority for Rendy B2B plans.
 * Aligned with commercial tiers (Starter up to 5 users, Growth up to 15 users, Enterprise up to 40+ users)
 * and 7-day Netflix-style free trial ($0.00 due today, automatic billing on Day 8).
 */
export const SUBSCRIPTION_PLANS: Record<PlanId, SubscriptionPlanDefinition> = {
  STARTER: {
    id: 'STARTER',
    tier: 'STARTER',
    name: 'Equipos en Inicio',
    tagline: 'Para pequeños negocios y equipos de calle que necesitan centralizar facturas sin papeleos.',
    minEmployees: 1,
    maxEmployees: 5,
    monthlyPriceUsd: 49,
    annualMonthlyEquivalentUsd: 39,
    annualTotalUsd: 468, // $39 * 12
    annualDiscountPercent: 20,
    isBestSeller: false,
    trialDays: 7,
  },
  GROWTH: {
    id: 'GROWTH',
    tier: 'GROWTH',
    name: 'Empresas en Expansión',
    tagline: 'Para organizaciones con fuerza de ventas, logística o proyectos que requieren control financiero estricto.',
    minEmployees: 6,
    maxEmployees: 15,
    monthlyPriceUsd: 119,
    annualMonthlyEquivalentUsd: 95,
    annualTotalUsd: 1140, // $95 * 12
    annualDiscountPercent: 20,
    isBestSeller: true,
    trialDays: 7,
  },
  ENTERPRISE: {
    id: 'ENTERPRISE',
    tier: 'ENTERPRISE',
    name: 'Corporativo & Auditoría',
    tagline: 'Para medianas empresas con alto volumen de gastos, múltiples departamentos y supervisión gerencial.',
    minEmployees: 16,
    maxEmployees: null,
    monthlyPriceUsd: 249,
    annualMonthlyEquivalentUsd: 199,
    annualTotalUsd: 2388, // $199 * 12
    annualDiscountPercent: 20,
    isBestSeller: false,
    trialDays: 7,
  },
};

export interface PlanRecommendationResult {
  recommendedPlanId: PlanId;
  bestSellerPlanId: PlanId;
  plans: Array<
    SubscriptionPlanDefinition & {
      isRecommended: boolean;
      displayMonthlyPriceUsd: number;
      billedTodayUsd: number;
      billedAfterTrialUsd: number;
    }
  >;
}

/**
 * @name recommendPlanByEmployeeCount
 * @description [Business Logic]: Evaluates the company's estimated headcount entered during
 * onboarding Step 2 and highlights the optimal plan ("Recommended for you") alongside the
 * "Best Seller" badge, calculating exact $0.00 due today and Day-8 recurring charges.
 */
export function recommendPlanByEmployeeCount(
  estimatedEmployees: number,
  billingCycle: BillingCycle
): PlanRecommendationResult {
  let recommendedPlanId: PlanId = 'GROWTH';

  if (estimatedEmployees <= 5) {
    recommendedPlanId = 'STARTER';
  } else if (estimatedEmployees <= 15) {
    recommendedPlanId = 'GROWTH';
  } else {
    recommendedPlanId = 'ENTERPRISE';
  }

  const orderedIds: PlanId[] = ['STARTER', 'GROWTH', 'ENTERPRISE'];

  const plans = orderedIds.map((id) => {
    const plan = SUBSCRIPTION_PLANS[id];
    const displayMonthlyPriceUsd =
      billingCycle === 'ANNUAL' ? plan.annualMonthlyEquivalentUsd : plan.monthlyPriceUsd;
    const billedAfterTrialUsd =
      billingCycle === 'ANNUAL' ? plan.annualTotalUsd : plan.monthlyPriceUsd;

    return {
      ...plan,
      isRecommended: id === recommendedPlanId,
      displayMonthlyPriceUsd,
      billedTodayUsd: 0,
      billedAfterTrialUsd,
    };
  });

  return {
    recommendedPlanId,
    bestSellerPlanId: 'GROWTH',
    plans,
  };
}

/**
 * @name resolveStripePriceId
 * @description [Security & Billing]: Resolves the authoritative Stripe Price ID from server
 * environment variables for the requested plan and billing cycle. Prevents client-side price tampering.
 */
export function resolveStripePriceId(planId: PlanId, billingCycle: BillingCycle): string {
  const envMap: Record<`${PlanId}_${BillingCycle}`, string | undefined> = {
    STARTER_MONTHLY: process.env.STRIPE_PRICE_STARTER_MONTHLY,
    STARTER_ANNUAL: process.env.STRIPE_PRICE_STARTER_ANNUAL,
    GROWTH_MONTHLY: process.env.STRIPE_PRICE_GROWTH_MONTHLY,
    GROWTH_ANNUAL: process.env.STRIPE_PRICE_GROWTH_ANNUAL,
    ENTERPRISE_MONTHLY: process.env.STRIPE_PRICE_ENTERPRISE_MONTHLY,
    ENTERPRISE_ANNUAL: process.env.STRIPE_PRICE_ENTERPRISE_ANNUAL,
  };

  const priceId = envMap[`${planId}_${billingCycle}`];
  if (!priceId || !priceId.startsWith('price_')) {
    throw new Error(`Missing or invalid Stripe Price ID configuration for ${planId}_${billingCycle}`);
  }

  return priceId;
}

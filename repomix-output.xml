}

:root {
  --radius: 0.5rem;

  /* Landing Page Brand Colors (OKLCH) */
  --surface-container-lowest: oklch(0.165 0.02 269.9);
  --surface-container-low: oklch(0.224 0.02 271.7);
  --surface-container: oklch(0.241 0.02 271.8);
  --surface-container-high: oklch(0.286 0.019 272);
  --surface-container-highest: oklch(0.328 0.02 277.1);
  --surface-bright: oklch(0.346 0.018 272.2);
  --on-surface: oklch(0.915 0.018 279);
  --on-surface-variant: oklch(0.825 0.026 152.8);
  --outline: oklch(0.653 0.026 154.8);
  --outline-variant: oklch(0.393 0.024 158.7);

  --primary-brand: oklch(0.903 0.16 160);
  --primary-container: oklch(0.814 0.183 160.4);
  --on-primary-container: #0B0E17;
  --primary-fixed: oklch(0.892 0.179 160.1);
  --primary-fixed-dim: oklch(0.806 0.181 160.4);
  --on-primary: oklch(0.301 0.068 160.3);
  --on-primary-fixed: oklch(0.219 0.05 159.9);
  --secondary-fixed: oklch(0.909 0.069 216.8);
  --on-secondary: oklch(0.306 0.054 214.4);
  --tertiary: oklch(0.924 0.077 83.2);
  --tertiary-container: oklch(0.84 0.165 84.5);
  --tertiary-fixed-dim: oklch(0.831 0.164 84.3);
  --on-tertiary-fixed: oklch(0.227 0.046 85);
  --error: oklch(0.838 0.089 26.8);
  --error-container: oklch(0.417 0.17 27.4);
  --on-error: oklch(0.328 0.134 27.3);

  --background: var(--surface-container-lowest);
  --foreground: var(--on-surface);
  --card: var(--surface-container);
  --card-foreground: var(--on-surface);
  --popover: var(--surface-container);
  --popover-foreground: var(--on-surface);
  --primary: var(--primary-brand);
  --primary-foreground: var(--on-primary);
  --secondary: oklch(0.817 0.124 215.7);
  --secondary-foreground: var(--on-secondary);
  --muted: var(--surface-container-high);
  --muted-foreground: var(--on-surface-variant);
  --accent: var(--surface-container-high);
  --accent-foreground: var(--on-surface);
  --destructive: var(--error);
  --destructive-foreground: var(--on-error);
  --border: var(--outline-variant);
  --input: var(--outline-variant);
  --ring: var(--primary-container);

  /* ==========================================================
     DASHBOARD ALIGNMENT TO LANDING BRAND PALETTE
     ========================================================== */
  --rendy-primary: var(--primary-brand);
  --rendy-primary-dark: var(--primary-container);
  --rendy-primary-light: var(--primary-fixed);
  --rendy-accent: var(--secondary);
  --rendy-accent-dark: var(--on-secondary);
  --rendy-warning: var(--tertiary-container);
  --rendy-danger: var(--error);

  --bg-base: var(--surface-container-lowest);
  --bg-surface: var(--surface-container-low);
  --bg-elevated: var(--surface-container);
  --bg-overlay: var(--surface-container-high);
  --bg-border: var(--outline-variant);

  --text-primary: var(--on-surface);
  --text-secondary: var(--on-surface-variant);
  --text-muted: var(--outline);
  --text-accent: var(--primary-brand);

  --sidebar-width: 260px;
  --sidebar-collapsed: 72px;

  --transition-fast: 150ms ease;
  --transition-base: 250ms ease;
  --transition-slow: 400ms ease;

  --shadow-glow: 0 0 30px color-mix(in oklab, var(--primary-container) 20%, transparent);
  --shadow-card: 0 4px 24px oklch(0 0 0 / 40%);
}

@layer base {
  *, *::before, *::after {
    border-color: var(--color-border);
    box-sizing: border-box;
  }

  html {
    height: 100%;
    scroll-behavior: smooth;
    scroll-padding-top: 5rem;
  }

  body {
    height: 100%;
    margin: 0;
    background-color: var(--color-background);
    color: var(--color-foreground);
    font-family: var(--font-body);
    overscroll-behavior: none;
    -webkit-font-smoothing: antialiased;
    -moz-osx-font-smoothing: grayscale;
    line-height: 1.6;
  }

  ::selection {
    background-color: var(--color-primary-container);
    color: var(--color-on-primary-fixed);
  }
}

/* Material Symbols icon font */
.material-symbols-outlined {
  font-family: "Material Symbols Outlined";
  font-weight: normal;
  font-style: normal;
  line-height: 1;
  letter-spacing: normal;
  text-transform: none;
  display: inline-block;
  white-space: nowrap;
  word-wrap: normal;
  direction: ltr;
  -webkit-font-feature-settings: "liga";
  font-feature-settings: "liga";
  -webkit-font-smoothing: antialiased;
  font-variation-settings: "FILL" 0, "wght" 400, "GRAD" 0, "opsz" 24;
}

/* ---------- Motion Utilities ---------- */
@keyframes float-slow {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-8px) rotate(0.5deg); }
}
@keyframes float-delayed {
  0%, 100% { transform: translateY(0) rotate(0deg); }
  50% { transform: translateY(-7px) rotate(-0.5deg); }
}
@keyframes float-card-gentle {
  0%, 100% { transform: translateY(0); }
  50% { transform: translateY(-6px); }
}
@keyframes pulse-glow-ambient {
  0%, 100% { opacity: 0.12; transform: scale(1); }
  50% { opacity: 0.24; transform: scale(1.08); }
}
@keyframes entrance-fade-up {
  0% { opacity: 0; transform: translateY(12px); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes entrance-fade-down {
  0% { opacity: 0; transform: translateY(-10px); }
  100% { opacity: 1; transform: translateY(0); }
}
@keyframes entrance-fade-scale {
  0% { opacity: 0; transform: scale(0.97) translateY(8px); }
  100% { opacity: 1; transform: scale(1) translateY(0); }
}
@keyframes pulse-radar {
  0% { transform: scale(1); opacity: 0.9; }
  70% { transform: scale(2.4); opacity: 0; }
  100% { transform: scale(2.4); opacity: 0; }
}
@keyframes draw-line {
  0% { stroke-dashoffset: 1200; }
  100% { stroke-dashoffset: 0; }
}
@keyframes shimmer-border {
  0% { background-position: 0% 50%; }
  50% { background-position: 100% 50%; }
  100% { background-position: 0% 50%; }
}
@keyframes shimmer-sweep {
  0% { transform: translateX(-100%); }
  100% { transform: translateX(200%); }
}

@keyframes pricing-card-switch {
  0% {
    transform: scale(0.985) translateY(4px);
  }
  50% {
    transform: scale(1.012) translateY(-3px);
  }
  100% {
    transform: scale(1) translateY(0);
  }
}

@keyframes pricing-shine {
  0% {
    transform: translateX(-150%) skewX(-20deg);
    opacity: 0;
  }
  35% {
    opacity: 1;
  }
  100% {
    transform: translateX(250%) skewX(-20deg);
    opacity: 0;
  }
}

@keyframes price-number-tick {
  0% {
    transform: translateY(8px);
    opacity: 0;
    filter: blur(2px);
  }
  100% {
    transform: translateY(0);
    opacity: 1;
    filter: blur(0);
  }
}

@keyframes annual-badge-pop {
  0% {
    transform: scale(0.7) translateY(2px);
    opacity: 0;
  }
  60% {
    transform: scale(1.06) translateY(-1px);
    opacity: 1;
  }
  100% {
    transform: scale(1) translateY(0);
    opacity: 1;
  }
}

/* Onboarding Step Entrance and Exit Transitions */
@keyframes step-fade-in-forward {
  0% {
    opacity: 0;
    transform: translateX(20px) scale(0.985);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes step-fade-out-forward {
  0% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateX(-20px) scale(0.985);
  }
}

@keyframes step-fade-in-backward {
  0% {
    opacity: 0;
    transform: translateX(-20px) scale(0.985);
  }
  100% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
}

@keyframes step-fade-out-backward {
  0% {
    opacity: 1;
    transform: translateX(0) scale(1);
  }
  100% {
    opacity: 0;
    transform: translateX(20px) scale(0.985);
  }
}

@keyframes card-item-enter {
  0% {
    opacity: 0;
    transform: translateY(12px) scale(0.97);
  }
  100% {
    opacity: 1;
    transform: translateY(0) scale(1);
  }
}

@utility animate-step-enter-forward {
  animation: step-fade-in-forward 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@utility animate-step-exit-forward {
  animation: step-fade-out-forward 0.18s cubic-bezier(0.4, 0, 1, 1) both;
}

@utility animate-step-enter-backward {
  animation: step-fade-in-backward 0.28s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@utility animate-step-exit-backward {
  animation: step-fade-out-backward 0.18s cubic-bezier(0.4, 0, 1, 1) both;
}

@utility animate-card-enter {
  animation: card-item-enter 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@utility animate-pricing-card {
  animation: pricing-card-switch 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@utility animate-pricing-shine {
  animation: pricing-shine 0.85s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}

@utility animate-price-tick {
  animation: price-number-tick 0.35s cubic-bezier(0.16, 1, 0.3, 1) both;
}

@utility animate-annual-badge {
  animation: annual-badge-pop 0.4s cubic-bezier(0.34, 1.56, 0.64, 1) both;
}

@utility animate-float-slow {
  animation: float-slow 5s ease-in-out infinite;
}
@utility animate-float-delayed {
  animation: float-delayed 6s ease-in-out 1.2s infinite;
}
@utility animate-float-gentle {
  animation: float-card-gentle 6s ease-in-out infinite;
}
@utility animate-glow-ambient {
  animation: pulse-glow-ambient 7s ease-in-out infinite;
}
@utility animate-enter-up {
  animation: entrance-fade-up 0.5s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@utility animate-enter-down {
  animation: entrance-fade-down 0.45s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@utility animate-enter-card {
  animation: entrance-fade-scale 0.55s cubic-bezier(0.16, 1, 0.3, 1) both;
}
@utility animate-radar {
  &::after {
    content: "";
    position: absolute;
    inset: -2px;
    border-radius: 9999px;
    background-color: var(--primary-container);
    animation: pulse-radar 2.4s cubic-bezier(0, 0, 0.2, 1) infinite;
    z-index: 0;
    pointer-events: none;
  }
}
@utility shimmer-card-border {
  position: relative;
  background: linear-gradient(
    135deg,
    color-mix(in oklab, var(--primary-container) 30%, transparent) 0%,
    color-mix(in oklab, var(--secondary) 15%, transparent) 50%,
    color-mix(in oklab, var(--primary-container) 5%, transparent) 100%
  );
  background-size: 200% 200%;
  animation: shimmer-border 8s ease infinite;
}
@utility chart-animated-path {
  stroke-dasharray: 1200;
  stroke-dashoffset: 1200;
  animation: draw-line 2.4s cubic-bezier(0.16, 1, 0.3, 1) forwards;
}
@utility shimmer-bar {
  position: relative;
  overflow: hidden;
  &::after {
    content: "";
    position: absolute;
    inset: 0;
    background: linear-gradient(90deg, transparent, oklch(1 0 0 / 40%), transparent);
    transform: translateX(-100%);
    animation: shimmer-sweep 2.5s infinite;
  }
}
@utility reveal {
  opacity: 0;
  transform: translateY(22px);
  transition:
    opacity 0.8s cubic-bezier(0.16, 1, 0.3, 1),
    transform 0.8s cubic-bezier(0.16, 1, 0.3, 1);
  will-change: opacity, transform;
  &.revealed {
    opacity: 1;
    transform: translateY(0);
  }
}
@utility feature-card-glow {
  transition: all 0.35s cubic-bezier(0.16, 1, 0.3, 1);
  border: 1px solid color-mix(in oklab, var(--outline) 15%, transparent);
  &:hover {
    transform: translateY(-5px);
    border-color: color-mix(in oklab, var(--primary-container) 50%, transparent);
    box-shadow: 0 12px 30px -10px color-mix(in oklab, var(--primary-container) 20%, transparent);
  }
}
@utility no-scrollbar {
  scrollbar-width: none;
  &::-webkit-scrollbar {
    display: none;
  }
}

@media (prefers-reduced-motion: reduce) {
  .animate-float-slow,
  .animate-float-delayed,
  .animate-radar::after,
  .chart-animated-path,
  .shimmer-bar::after {
    animation: none !important;
  }
  .reveal {
    opacity: 1 !important;
    transform: none !important;
    transition: none !important;
  }
  .chart-animated-path {
    stroke-dashoffset: 0 !important;
  }
}

/* ==========================================================================
   2. DASHBOARD SPECIFIC COMPONENTS & LAYOUT
   ========================================================================== */

/* SCROLLBAR */
::-webkit-scrollbar { width: 6px; height: 6px; }
::-webkit-scrollbar-track { background: var(--bg-surface); }
::-webkit-scrollbar-thumb { background: color-mix(in oklab, var(--rendy-primary) 30%, transparent); border-radius: 3px; }
::-webkit-scrollbar-thumb:hover { background: color-mix(in oklab, var(--rendy-primary) 50%, transparent); }

/* LAYOUT SHELL */
.dashboard-shell {
  display: flex;
  height: 100vh;
  overflow: hidden;
}

.main-content {
  flex: 1;
  display: flex;
  flex-direction: column;
  overflow: hidden;
  margin-left: var(--sidebar-width);
  transition: margin-left var(--transition-base);
}

.main-content.sidebar-collapsed {
  margin-left: var(--sidebar-collapsed);
}

.page-area {
  flex: 1;
  overflow-y: auto;
  padding: 28px 32px;
  background: var(--bg-base);
}

/* SIDEBAR */
.sidebar {
  position: fixed;
  left: 0;
  top: 0;
  bottom: 0;
  width: var(--sidebar-width);
  background: var(--bg-surface);
  border-right: 1px solid var(--bg-border);
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: width var(--transition-base);
  z-index: 50;
  box-shadow: 4px 0 24px oklch(0 0 0 / 30%);
}

.sidebar.collapsed {
  width: var(--sidebar-collapsed);
}

.sidebar-brand {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 20px 18px;
  border-bottom: 1px solid var(--bg-border);
  min-height: 72px;
  overflow: hidden;
}

.sidebar-brand-logo {
  width: 36px;
  height: 36px;
  display: flex;
  align-items: center;
  justify-content: center;
  flex-shrink: 0;
}

.sidebar-brand-text {
  display: flex;
  flex-direction: column;
  overflow: hidden;
  transition: opacity var(--transition-base), width var(--transition-base);
}

.sidebar-brand-name {
  font-size: 18px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.3px;
  white-space: nowrap;
}

.sidebar-brand-tagline {
  font-size: 11px;
  color: var(--text-accent);
  white-space: nowrap;
  margin-top: -2px;
}

.sidebar-nav {
  flex: 1;
  padding: 12px 10px;
  overflow-y: auto;
  overflow-x: hidden;
}

.nav-section-label {
  font-size: 10px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.08em;
  color: var(--text-muted);
  padding: 16px 10px 6px;
  white-space: nowrap;
  overflow: hidden;
  transition: opacity var(--transition-base);
}

.sidebar.collapsed .nav-section-label {
  opacity: 0;
}

.nav-item {
  display: flex;
  align-items: center;
  gap: 12px;
  padding: 10px 12px;
  border-radius: 10px;
  cursor: pointer;
  transition: all var(--transition-fast);
  position: relative;
  overflow: hidden;
  margin-bottom: 2px;
  text-decoration: none;
  color: var(--text-secondary);
  white-space: nowrap;
}

.nav-item:hover {
  background: color-mix(in oklab, var(--rendy-primary) 10%, transparent);
  color: var(--text-primary);
}

.nav-item.active {
  background: color-mix(in oklab, var(--rendy-primary) 18%, transparent);
  color: var(--rendy-primary-light);
}

.nav-item.active::before {
  content: '';
  position: absolute;
  left: 0;
  top: 50%;
  transform: translateY(-50%);
  width: 3px;
  height: 60%;
  background: var(--rendy-primary);
  border-radius: 0 4px 4px 0;
}

.nav-item-icon {
  width: 20px;
  height: 20px;
  flex-shrink: 0;
  display: flex;
  align-items: center;
  justify-content: center;
}

.nav-item-label {
  font-size: 14px;
  font-weight: 500;
  transition: opacity var(--transition-base);
  overflow: hidden;
}

.nav-badge {
  margin-left: auto;
  background: var(--rendy-primary);
  color: var(--surface-container-lowest);
  font-size: 10px;
  font-weight: 700;
  padding: 2px 6px;
  border-radius: 10px;
  min-width: 18px;
  text-align: center;
  flex-shrink: 0;
  transition: opacity var(--transition-base);
}

.sidebar.collapsed .nav-item-label,
.sidebar.collapsed .nav-badge,
.sidebar.collapsed .sidebar-brand-text {
  opacity: 0;
  pointer-events: none;
  width: 0;
  margin-left: 0;
}

.sidebar-footer {
  padding: 12px 10px;
  border-top: 1px solid var(--bg-border);
}

.sidebar-org-pill {
  display: flex;
  align-items: center;
  gap: 10px;
  padding: 10px 12px;
  background: var(--bg-elevated);
  border-radius: 10px;
  overflow: hidden;
  border: 1px solid var(--bg-border);
}

.sidebar-org-avatar {
  width: 30px;
  height: 30px;
  border-radius: 8px;
  background: linear-gradient(135deg, var(--rendy-accent-dark), var(--rendy-accent));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 12px;
  font-weight: 700;
  color: white;
  flex-shrink: 0;
}

.sidebar-org-info {
  overflow: hidden;
  transition: opacity var(--transition-base);
}

.sidebar-org-name {
  font-size: 13px;
  font-weight: 600;
  color: var(--text-primary);
  white-space: nowrap;
}

.sidebar-org-role {
  font-size: 11px;
  color: var(--text-accent);
  white-space: nowrap;
}

.sidebar.collapsed .sidebar-org-info {
  opacity: 0;
  pointer-events: none;
}

.sidebar-toggle {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 28px;
  height: 28px;
  border-radius: 6px;
  background: transparent;
  border: none;
  cursor: pointer;
  color: var(--text-muted);
  transition: all var(--transition-fast);
  margin-left: auto;
  flex-shrink: 0;
}

.sidebar-toggle:hover {
  background: color-mix(in oklab, var(--rendy-primary) 15%, transparent);
  color: var(--text-primary);
}

/* TOPBAR */
.topbar {
  height: 64px;
  background: var(--bg-surface);
  border-bottom: 1px solid var(--bg-border);
  display: flex;
  align-items: center;
  padding: 0 28px;
  gap: 16px;
  flex-shrink: 0;
}

.topbar-breadcrumb {
  display: flex;
  align-items: center;
  gap: 8px;
  flex: 1;
}

.topbar-breadcrumb-root {
  font-size: 13px;
  color: var(--text-muted);
}

.topbar-breadcrumb-sep {
  color: var(--text-muted);
  font-size: 12px;
}

.topbar-breadcrumb-page {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}

.topbar-actions {
  display: flex;
  align-items: center;
  gap: 10px;
}

.topbar-btn {
  display: flex;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--bg-elevated);
  border: 1px solid var(--bg-border);
  cursor: pointer;
  color: var(--text-secondary);
  transition: all var(--transition-fast);
  position: relative;
}

.topbar-btn:hover {
  background: color-mix(in oklab, var(--rendy-primary) 12%, transparent);
  color: var(--text-primary);
  border-color: color-mix(in oklab, var(--rendy-primary) 30%, transparent);
}

.topbar-btn-dot {
  position: absolute;
  top: 7px;
  right: 7px;
  width: 7px;
  height: 7px;
  background: var(--rendy-danger);
  border-radius: 50%;
  border: 1.5px solid var(--bg-surface);
}

.topbar-avatar {
  width: 36px;
  height: 36px;
  border-radius: 50%;
  background: linear-gradient(135deg, var(--rendy-primary), var(--rendy-primary-light));
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 13px;
  font-weight: 700;
  color: var(--surface-container-lowest);
  cursor: pointer;
  border: 2px solid color-mix(in oklab, var(--rendy-primary) 40%, transparent);
  transition: border-color var(--transition-fast);
}

.topbar-avatar:hover {
  border-color: var(--rendy-primary-light);
}

/* PAGE HEADER */
.page-header {
  margin-bottom: 28px;
}

.page-title {
  font-size: 26px;
  font-weight: 700;
  color: var(--text-primary);
  letter-spacing: -0.4px;
  display: flex;
  align-items: center;
  gap: 10px;
  margin-bottom: 4px;
}

.page-subtitle {
  font-size: 14px;
  color: var(--text-secondary);
}

/* KPI CARDS */
.kpi-grid {
  display: grid;
  grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
  gap: 16px;
  margin-bottom: 28px;
}

.kpi-card {
  background: var(--bg-surface);
  border: 1px solid var(--bg-border);
  border-radius: 14px;
  padding: 20px 22px;
  position: relative;
  overflow: hidden;
  min-width: 0;
  display: flex;
  flex-direction: column;
  justify-content: space-between;
  transition: transform var(--transition-fast), box-shadow var(--transition-fast);
}

.kpi-card::before {
  content: '';
  position: absolute;
  inset: 0;
  background: linear-gradient(135deg, color-mix(in oklab, var(--rendy-primary) 4%, transparent), transparent);
  pointer-events: none;
}

.kpi-card:hover {
  transform: translateY(-2px);
  box-shadow: var(--shadow-glow);
}

.kpi-card-icon {
  width: 42px;
  height: 42px;
  border-radius: 10px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin-bottom: 14px;
}

.kpi-card-icon.indigo  { background: color-mix(in oklab, var(--rendy-primary) 15%, transparent); color: var(--rendy-primary-light); }
.kpi-card-icon.emerald { background: color-mix(in oklab, var(--rendy-accent) 15%, transparent); color: var(--rendy-accent); }
.kpi-card-icon.amber   { background: color-mix(in oklab, var(--rendy-warning) 15%, transparent); color: var(--rendy-warning); }
.kpi-card-icon.rose    { background: color-mix(in oklab, var(--rendy-danger) 15%, transparent); color: var(--rendy-danger); }

.kpi-card-label {
  font-size: 12px;
  font-weight: 500;
  color: var(--text-muted);
  text-transform: uppercase;
  letter-spacing: 0.05em;
  margin-bottom: 6px;
}

.kpi-card-value {
  font-size: clamp(20px, 2.2vw, 26px);
  font-weight: 800;
  color: var(--text-primary);
  letter-spacing: -0.5px;
  line-height: 1.15;
  margin-bottom: 8px;
  word-break: break-word;
  overflow-wrap: anywhere;
}

.kpi-card-delta {
  font-size: 12px;
  display: flex;
  align-items: center;
  gap: 4px;
  font-weight: 500;
}

.kpi-card-delta.up   { color: var(--rendy-accent); }
.kpi-card-delta.down { color: var(--rendy-danger); }

/* CARDS, TABLES, BADGES & BUTTONS */
.card {
  background: var(--bg-surface);
  border: 1px solid var(--bg-border);
  border-radius: 14px;
  overflow: hidden;
}

.card-header {
  padding: 20px 24px 0;
  display: flex;
  align-items: center;
  justify-content: space-between;
  margin-bottom: 16px;
}

.card-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-primary);
}

.card-body {
  padding: 0 24px 24px;
}

.badge {
  display: inline-flex;
  align-items: center;
  gap: 5px;
  padding: 3px 10px;
  border-radius: 20px;
  font-size: 11px;
  font-weight: 600;
  letter-spacing: 0.03em;
}

.badge-dot {
  width: 6px;
  height: 6px;
  border-radius: 50%;
}

.badge.pendiente  { background: color-mix(in oklab, var(--rendy-warning) 15%, transparent); color: var(--rendy-warning); }
.badge.pendiente .badge-dot { background: var(--rendy-warning); }
.badge.aprobado   { background: color-mix(in oklab, var(--rendy-accent) 15%, transparent); color: var(--rendy-accent); }
.badge.aprobado .badge-dot  { background: var(--rendy-accent); }
.badge.rechazado  { background: color-mix(in oklab, var(--rendy-danger) 15%, transparent); color: var(--rendy-danger); }
.badge.rechazado .badge-dot { background: var(--rendy-danger); }
.badge.pagado     { background: color-mix(in oklab, var(--rendy-primary) 15%, transparent); color: var(--rendy-primary-light); }
.badge.pagado .badge-dot    { background: var(--rendy-primary-light); }

.rendy-table {
  width: 100%;
  border-collapse: collapse;
}

.rendy-table th {
  font-size: 11.5px;
  font-weight: 600;
  text-transform: uppercase;
  letter-spacing: 0.05em;
  color: var(--text-muted);
  padding: 13px 16px;
  vertical-align: middle;
  text-align: left;
  border-bottom: 1px solid var(--bg-border);
  background: oklch(1 0 0 / 1.5%);
  white-space: nowrap;
}

.rendy-table td {
  padding: 13px 16px;
  font-size: 13.5px;
  color: var(--text-secondary);
  border-bottom: 1px solid color-mix(in oklab, var(--bg-border) 40%, transparent);
  vertical-align: middle;
}

.rendy-table tr:last-child td {
  border-bottom: none;
}

.rendy-table tr:hover td {
  background: color-mix(in oklab, var(--rendy-primary) 4%, transparent);
}

.progress-track {
  height: 6px;
  background: var(--bg-overlay);
  border-radius: 99px;
  overflow: hidden;
}

.progress-fill {
  height: 100%;
  border-radius: 99px;
  background: linear-gradient(90deg, var(--rendy-primary), var(--rendy-primary-light));
  transition: width var(--transition-slow);
}

.progress-fill.accent {
  background: linear-gradient(90deg, var(--rendy-accent-dark), var(--rendy-accent));
}

.progress-fill.warning {
  background: linear-gradient(90deg, var(--rendy-warning), var(--tertiary));
}

.btn {
  display: inline-flex;
  align-items: center;
  gap: 7px;
  padding: 8px 16px;
  border-radius: 8px;
  font-size: 13px;
  font-weight: 600;
  cursor: pointer;
  transition: all var(--transition-fast);
  border: none;
  text-decoration: none;
  white-space: nowrap;
}

.btn-primary {
  background: var(--rendy-primary);
  color: var(--surface-container-lowest);
}

.btn-primary:hover {
  background: var(--rendy-primary-dark);
  box-shadow: 0 0 20px color-mix(in oklab, var(--rendy-primary) 35%, transparent);
}

.btn-ghost {
  background: transparent;
  color: var(--text-secondary);
  border: 1px solid var(--bg-border);
}

.btn-ghost:hover {
  background: var(--bg-elevated);
  color: var(--text-primary);
}

.btn-success {
  background: var(--rendy-accent);
  color: var(--surface-container-lowest);
}

.btn-success:hover {
  background: var(--rendy-accent-dark);
}

.btn-danger {
  background: transparent;
  color: var(--rendy-danger);
  border: 1px solid color-mix(in oklab, var(--rendy-danger) 30%, transparent);
}

.btn-danger:hover {
  background: color-mix(in oklab, var(--rendy-danger) 10%, transparent);
}

.btn-sm {
  padding: 5px 11px;
  font-size: 12px;
}

.empty-state {
  text-align: center;
  padding: 60px 24px;
  color: var(--text-muted);
}

.empty-state-icon {
  width: 56px;
  height: 56px;
  background: var(--bg-elevated);
  border-radius: 16px;
  display: flex;
  align-items: center;
  justify-content: center;
  margin: 0 auto 16px;
  color: var(--text-muted);
}

.empty-state-title {
  font-size: 15px;
  font-weight: 600;
  color: var(--text-secondary);
  margin-bottom: 6px;
}

.empty-state-desc {
  font-size: 13px;
  color: var(--text-muted);
  max-width: 280px;
  margin: 0 auto;
}

/* RESPONSIVE LAYOUT & MEDIA QUERIES */
.dashboard-grid {
  display: grid;
  grid-template-columns: 1fr 340px;
  gap: 16px;
  align-items: start;
}

.dashboard-main-stack,
.dashboard-side-stack {
  display: flex;
  flex-direction: column;
  gap: 16px;
  min-width: 0;
}

@media (max-width: 1080px) {
  .dashboard-grid {
    grid-template-columns: 1fr;
  }
}

.mobile-menu-btn {
  display: none;
  align-items: center;
  justify-content: center;
  width: 36px;
  height: 36px;
  border-radius: 8px;
  background: var(--bg-elevated);
  border: 1px solid var(--bg-border);
  color: var(--text-primary);
  cursor: pointer;
  margin-right: 8px;
}

@media (max-width: 768px) {
  .mobile-menu-btn {
    display: inline-flex;
  }

  .main-content {
    margin-left: 0 !important;
  }

  .sidebar {
    transform: translateX(-100%);
    transition: transform var(--transition-base);
    z-index: 1000;
    width: 260px !important;
  }

  .sidebar.mobile-open {
    transform: translateX(0);
  }

  .sidebar-backdrop {
    position: fixed;
    inset: 0;
    background: oklch(0 0 0 / 70%);
    backdrop-filter: blur(4px);
    z-index: 999;
  }

  .page-area {
    padding: 18px 16px;
  }

  .topbar {
    padding: 0 16px;
  }

  .topbar-breadcrumb-root,
  .topbar-breadcrumb-sep {
    display: none;
  }

  .page-title {
    font-size: 20px;
    flex-wrap: wrap;
  }

  .page-subtitle {
    font-size: 13px;
  }

  .kpi-grid {
    grid-template-columns: 1fr;
    gap: 12px;
    margin-bottom: 20px;
  }

  .dashboard-grid,
  .dashboard-main-stack,
  .dashboard-side-stack {
    gap: 12px;
  }

  .card-header {
    padding: 16px 16px 0;
  }

  .card-body {
    padding: 0 16px 16px;
  }
}

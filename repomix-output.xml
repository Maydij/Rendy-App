    { id: 'reembolsos-pendientes', label: 'Reembolsos Pendientes', value: fmt(kpis.reembolsosPendientes, moneda), icon: RotateCcw, color: 'rose', trend: kpis.reembolsosPendientes > 0 ? 'down' as const : 'up' as const },

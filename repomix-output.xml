        <div className="sidebar-brand-logo" aria-hidden="true">R</div>
        <div className="sidebar-brand-text">
          <span className="sidebar-brand-name">Rendy</span>
          <span className="sidebar-brand-tagline">by Swork · B2B SaaS</span>

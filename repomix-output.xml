}

/**
 * @name ReceiptImage
 * @description Renders the original receipt photograph or a placeholder
 * when no image was attached.
 */
function ReceiptImage({
  imageUrl,
  comercio,
}: {
  imageUrl: string | null;
  comercio: string;
}) {
  return (
    <div
      style={{
        display: 'flex',
        flexDirection: 'column',

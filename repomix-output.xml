<file path="lib/utils/phone.ts">
/**
 * @name PhoneUtilities
 * @description [Business Logic]: Utilities for normalizing, sanitizing, and validating
 * international phone numbers to the E.164 standard (+[country][national_number]).
 * Ensures consistent phone hashing and uniqueness checks across WhatsApp, DB queries,
 * and user onboarding.
 */

/**
 * @name normalizarTelefonoE164
 * @description [Business Logic]: Strips all non-digit characters except an optional leading plus,
 * and guarantees a leading '+' symbol.
 * Example: "0412 123 4567" -> "+04121234567", "+58 (412) 123-4567" -> "+584121234567".
 * If Venezuelan national format "0414...", "0424...", "0412..." is provided without country code,
 * converts to +58414...
 *
 * @param phone Raw phone string provided by user or webhook.
 * @returns Normalized E.164 phone string.
 */
export function normalizarTelefonoE164(phone: string): string {
  if (!phone || typeof phone !== 'string') {
    return '';
  }

  // Remove spaces, hyphens, parentheses, and dots
  let cleaned = phone.replace(/[^\d+]/g, '').trim();

  // If local Venezuelan mobile format (0412..., 0414..., 0424..., 0416..., 0426...)
  if (/^04(12|14|24|16|26)\d{7}$/.test(cleaned)) {
    cleaned = `+58${cleaned.substring(1)}`;
  } else if (!cleaned.startsWith('+')) {
    cleaned = `+${cleaned}`;
  }

  return cleaned;
}

/**
 * @name validarTelefonoE164
 * @description [Business Logic]: Validates whether a phone number strictly matches E.164 format:
 * starts with '+', followed by 8 to 15 digits.
 *
 * @param phone Normalized or raw phone string.
 * @returns True if valid E.164, false otherwise.
 */
export function validarTelefonoE164(phone: string): boolean {
  if (!phone || typeof phone !== 'string') {
    return false;
  }
  const normalized = normalizarTelefonoE164(phone);
  // ITU-T E.164 specifies maximum 15 digits (excluding the plus)
  return /^\+[1-9]\d{7,14}$/.test(normalized);
}
</file>

<file path="lib/utils/timed-map.ts">
/**
 * @name TimedMap
 * @description [Infrastructure]: A Map wrapper that automatically tracks the timestamp
 * of each entry and provides expiration logic. When `.get()` is called on an expired
 * entry, it returns `undefined` — making stale conversation sessions invisible to the
 * business logic without requiring changes to every call site.
 *
 * This solves the WhatsApp conversation timeout requirement: if a user abandons
 * a flow mid-way and returns 3+ minutes later, the stale session is automatically
 * discarded so the bot doesn't respond with incoherent follow-ups.
 */

const DEFAULT_TIMEOUT_MS = 3 * 60 * 1000; // 3 minutes

export class TimedMap<V> {
  private store = new Map<string, { value: V; timestamp: number }>();
  private readonly timeoutMs: number;

  constructor(timeoutMs: number = DEFAULT_TIMEOUT_MS) {
    this.timeoutMs = timeoutMs;
  }

  /**
   * @name set
   * @description Stores a value with an automatic timestamp. If the key already
   * exists, the entry and its timestamp are overwritten (refreshed).
   */
  set(key: string, value: V): void {
    this.store.set(key, { value, timestamp: Date.now() });
  }

  /**
   * @name get
   * @description Returns the stored value if it exists AND has not expired.
   * Expired entries return `undefined` (same as non-existent keys) so all
   * existing business logic that checks `if (entry)` works transparently.
   */
  get(key: string): V | undefined {
    const entry = this.store.get(key);
    if (!entry) return undefined;
    if (this.isEntryExpired(entry)) return undefined;
    return entry.value;
  }

  /**
   * @name delete
   * @description Removes an entry from the store (used on explicit cancel, confirm, etc.)
   */
  delete(key: string): void {
    this.store.delete(key);
  }

  /**
   * @name has
   * @description Returns true only if the key exists AND is not expired.
   */
  has(key: string): boolean {
    return this.get(key) !== undefined;
  }

  /**
   * @name consumeExpired
   * @description [Timeout Notification]: Checks if the key has an expired entry.
   * If so, deletes it from the store and returns the stale value (so the caller
   * can send a "session expired" notification). Returns `undefined` if the key
   * doesn't exist or is still active.
   *
   * This is a destructive read: after calling this, the expired entry is gone.
   */
  consumeExpired(key: string): V | undefined {
    const entry = this.store.get(key);
    if (!entry) return undefined;
    if (this.isEntryExpired(entry)) {
      this.store.delete(key);
      return entry.value;
    }
    return undefined;
  }

  /**
   * @name cleanup
   * @description Removes all expired entries. Useful for periodic memory hygiene
   * in long-running server processes.
   */
  cleanup(): void {
    for (const [key, entry] of this.store.entries()) {
      if (this.isEntryExpired(entry)) {
        this.store.delete(key);
      }
    }
  }

  private isEntryExpired(entry: { timestamp: number }): boolean {
    return Date.now() - entry.timestamp > this.timeoutMs;
  }
}
</file>

<file path="lib/utils/url.ts">
/**
 * @name UrlResolutionUtils
 * @description [Business Logic]: Multi-tier environment domain and base URL resolver for Rendy.
 * Automatically identifies the execution context across 3 distinct tiers:
 * 1. Localhost (Development): http://localhost:3000
 * 2. Staging (QA / Pre-production): https://rendystaging.vercel.app
 * 3. Production: Configured corporate domain (e.g. https://rendy.com) with defensive fallback.
 * Employs zero-trust host validation to defend against Host-Header Poisoning and SSRF attacks.
 */

export const CANONICAL_DOMAINS = {
  LOCAL: 'http://localhost:3000',
  STAGING: 'https://rendystaging.vercel.app',
  // Default fallback for production until the commercial domain is purchased and bound
  PRODUCTION_FALLBACK: 'https://rendystaging.vercel.app',
} as const;

/**
 * Whitelist regex patterns to prevent Host-Header injection / poisoning attacks.
 */
const TRUSTED_HOST_PATTERNS: RegExp[] = [
  /^localhost(:\d+)?$/,
  /^127\.0\.0\.1(:\d+)?$/,
  /^rendystaging\.vercel\.app$/,
  /^[a-zA-Z0-9-]+\.vercel\.app$/,
  /^rendy\.[a-z]+$/,
  /^[a-zA-Z0-9-]+\.rendy\.[a-z]+$/,
];

/**
 * @name isTrustedHost
 * @description [Security]: Verifies whether an incoming HTTP Host header belongs to authorized
 * Rendy infrastructure (localhost, Vercel preview/staging subdomains, or verified corporate domains).
 */
export function isTrustedHost(host: string): boolean {
  if (!host || typeof host !== 'string') return false;
  const cleanHost = host.trim().toLowerCase();
  return TRUSTED_HOST_PATTERNS.some((pattern) => pattern.test(cleanHost));
}

/**
 * @name cleanBaseUrl
 * @description [Helper]: Strips trailing slashes from a URL to prevent double-slash path concatenation.
 */
export function cleanBaseUrl(url: string): string {
  return url.trim().replace(/\/+$/, '');
}

/**
 * @name resolveAppBaseUrl
 * @description [Business Logic]: Determines the authoritative base URL for magic links, QR codes,
 * and email notifications. Priority hierarchy:
 * 1. Active HTTP Request Headers (x-forwarded-host / host) if trusted.
 * 2. Explicit Environment Variable (NEXT_PUBLIC_APP_URL) if valid and context-appropriate.
 * 3. Vercel System Variables (VERCEL_PROJECT_PRODUCTION_URL, VERCEL_URL).
 * 4. Staging / Localhost fallback depending on VERCEL_ENV or NODE_ENV.
 */
export function resolveAppBaseUrl(
  requestHeaders?: Headers | { get(name: string): string | null }
): string {
  // 1. Dynamic Request Inspection (highest precision when invoked within Server Actions or RSC)
  if (requestHeaders) {
    const forwardedHost = requestHeaders.get('x-forwarded-host');
    const directHost = requestHeaders.get('host');
    const incomingHost = (forwardedHost || directHost)?.split(',')[0].trim();

    if (incomingHost && isTrustedHost(incomingHost)) {
      const forwardedProto = requestHeaders.get('x-forwarded-proto')?.split(',')[0].trim();
      const isLocal = incomingHost.startsWith('localhost') || incomingHost.startsWith('127.0.0.1');
      const protocol = forwardedProto || (isLocal ? 'http' : 'https');
      return cleanBaseUrl(`${protocol}://${incomingHost}`);
    }
  }

  // 2. Explicit NEXT_PUBLIC_APP_URL evaluation
  const envUrl = process.env.NEXT_PUBLIC_APP_URL?.trim();
  const isVercelEnvironment = process.env.VERCEL === '1' || Boolean(process.env.VERCEL_ENV);

  if (envUrl && envUrl.length > 0) {
    // If deployed on Vercel but someone inadvertently configured localhost, ignore it
    const isLocalhostUrl = envUrl.includes('localhost') || envUrl.includes('127.0.0.1');
    if (!isVercelEnvironment || !isLocalhostUrl) {
      return cleanBaseUrl(envUrl);
    }
  }

  // 3. Vercel System Deployment Variables (automatically injected by Vercel platform)
  const vercelEnv = process.env.VERCEL_ENV; // 'production' | 'preview' | 'development'

  if (vercelEnv === 'preview') {
    // In staging / preview branch environments
    if (process.env.VERCEL_URL) {
      return cleanBaseUrl(`https://${process.env.VERCEL_URL}`);
    }
    return CANONICAL_DOMAINS.STAGING;
  }

  if (vercelEnv === 'production') {
    // In Vercel production: check if a custom production domain was bound
    if (process.env.VERCEL_PROJECT_PRODUCTION_URL) {
      return cleanBaseUrl(`https://${process.env.VERCEL_PROJECT_PRODUCTION_URL}`);
    }
    return CANONICAL_DOMAINS.PRODUCTION_FALLBACK;
  }

  // 4. Fallback based on Node execution environment
  if (process.env.NODE_ENV === 'production') {
    return CANONICAL_DOMAINS.STAGING;
  }

  return CANONICAL_DOMAINS.LOCAL;
}

/**
 * @name buildInvitationMagicLinkUrl
 * @description [Business Logic]: Constructs a fully qualified single-use activation URL
 * containing the 256-bit cryptographic invitation token and pre-filled temporary access code.
 */
export function buildInvitationMagicLinkUrl(
  token: string,
  tempPassword: string,
  requestHeaders?: Headers | { get(name: string): string | null }
): string {
  const baseUrl = resolveAppBaseUrl(requestHeaders);
  return `${baseUrl}/invitacion/${token}?code=${encodeURIComponent(tempPassword)}`;
}
</file>


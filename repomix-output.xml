                    >
                      {Math.max(0, selectedSolicitud.monto_otorgado - selectedSolicitud.monto_gastado).toLocaleString('es-VE', { minimumFractionDigits: 2 })} {selectedSolicitud.moneda}
                    </div>
                  </div>
                </div>
              </div>


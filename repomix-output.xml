<file path="app/dashboard/gastos/gastos-client.tsx">
'use client';

import { useState, useCallback } from 'react';
import { Receipt, Search, Eye } from 'lucide-react';
import { useEscapeClose } from '@/lib/hooks/use-escape-close';
import type { Gasto } from '@/lib/types/gasto';
import DigitalInvoice from './digital-invoice';

/**
 * @name GastosEmpresaClient
 * @description [Business View]: Renders the corporate expense table showing
 * all receipts justified via WhatsApp that were paid with company funds
 * (corporate cards, travel advances). Each row can open a DigitalInvoice modal.
 */
export default function GastosEmpresaClient({ gastos }: { gastos: Gasto[] }) {
  const [search, setSearch] = useState('');
  const [selectedGasto, setSelectedGasto] = useState<Gasto | null>(null);

  const handleCloseModal = useCallback(() => setSelectedGasto(null), []);

  useEscapeClose(handleCloseModal, selectedGasto !== null);

  const filtered = gastos.filter((g) =>
    g.empleado.toLowerCase().includes(search.toLowerCase()) ||
    g.comercio.toLowerCase().includes(search.toLowerCase()) ||
    g.proyecto.toLowerCase().includes(search.toLowerCase())
  );

  return (
    <>
      <div className="page-header">
        <h1 className="page-title"><Receipt size={24} strokeWidth={2} />Gastos de Empresa</h1>
        <p className="page-subtitle">Comprobantes justificados pagados con fondos corporativos (Tarjetas de crédito/débito de la empresa).</p>
      </div>

      <div style={{ position: 'relative', marginBottom: '20px' }}>
        <Search size={15} style={{ position: 'absolute', left: '12px', top: '50%', transform: 'translateY(-50%)', color: 'var(--text-muted)', pointerEvents: 'none' }} />
        <input
          id="gastos-search"
          type="search"
          placeholder="Buscar por empleado, comercio o proyecto…"
          value={search}
          onChange={(e) => setSearch(e.target.value)}
          style={{ width: '100%', background: 'var(--bg-surface)', border: '1px solid var(--bg-border)', borderRadius: '8px', padding: '9px 12px 9px 36px', color: 'var(--text-primary)', fontSize: '13px', outline: 'none' }}
        />
      </div>

      <div className="card">
        {gastos.length === 0 ? (
          <div className="empty-state">
            <div className="empty-state-icon"><Receipt size={22} /></div>
            <div className="empty-state-title">Sin gastos corporativos registrados</div>
            <div className="empty-state-desc">Los gastos registrados con tarjetas o fondos de la empresa aparecerán aquí.</div>
          </div>
        ) : (
          <div style={{ overflowX: 'auto', WebkitOverflowScrolling: 'touch' }}>
            <table className="rendy-table">
              <thead>
                <tr>
                  <th>Empleado</th>
                  <th>Categoría</th>
                  <th>Comercio</th>
                  <th>Monto</th>
                  <th>Tasa</th>
                  <th>Convertido</th>
                  <th>Proyecto</th>
                  <th>Fecha</th>
                  <th>Método</th>
                  <th style={{ textAlign: 'right' }}>Comprobante</th>
                </tr>
              </thead>
              <tbody>
                {filtered.map((g) => {
                  const tieneTasa = g.tasa_cambio && g.tasa_cambio !== 1;
                  const monedaViat = g.moneda_viatico || 'USD';

                  return (
                    <tr key={g.id}>
                      <td style={{ verticalAlign: 'middle', fontWeight: 600, color: 'var(--text-primary)' }}>{g.empleado}</td>
                      <td style={{ verticalAlign: 'middle' }}>
                        <span style={{ background: 'var(--bg-elevated)', padding: '2px 8px', borderRadius: '6px', fontSize: '11px', fontWeight: 600, color: 'var(--text-accent)' }}>
                          {g.categoria}
                        </span>
                      </td>
                      <td style={{ verticalAlign: 'middle' }}>{g.comercio}</td>
                      
                      {/* Monto Original */}
                      <td style={{ verticalAlign: 'middle', fontWeight: 700, color: 'var(--text-primary)' }}>
                        {g.monto.toLocaleString('es-VE', { minimumFractionDigits: 2 })} {g.moneda}
                      </td>

                      {/* Tasa de Cambio */}
                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>
                        {tieneTasa ? `${g.tasa_cambio}` : '1.00'}
                      </td>

                      {/* Monto Convertido / Deducible */}
                      <td style={{ verticalAlign: 'middle', fontWeight: 700, color: tieneTasa ? '#10b981' : 'var(--text-primary)' }}>
                        {g.monto_convertido != null && tieneTasa
                          ? `${g.monto_convertido.toLocaleString('es-VE', { minimumFractionDigits: 2 })} ${monedaViat}`
                          : `${g.monto.toLocaleString('es-VE', { minimumFractionDigits: 2 })} ${g.moneda}`}
                      </td>

                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>{g.proyecto}</td>
                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>{g.fecha_gasto}</td>
                      <td style={{ verticalAlign: 'middle', color: 'var(--text-muted)', fontSize: '12px' }}>{g.metodo_pago}</td>
                      <td style={{ verticalAlign: 'middle', textAlign: 'right' }}>
                        <button
                          onClick={() => setSelectedGasto(g)}
                          className="btn btn-ghost btn-sm"
                          style={{
                            background: 'rgba(99, 102, 241, 0.1)',
                            border: '1px solid rgba(99, 102, 241, 0.25)',
                            color: 'var(--rendy-primary-light)',
                            gap: '5px',
                            cursor: 'pointer',
                          }}
                        >
                          <Eye size={12} /> Ver
                        </button>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>

      {/* ── Digital Invoice Modal ── */}
      {selectedGasto && (
        <DigitalInvoice
          gasto={selectedGasto}
          onClose={handleCloseModal}
        />
      )}
    </>
  );
}
</file>

<file path="app/dashboard/justificacion/justificacion-client.tsx">
'use client';

import { useState, useEffect, useCallback } from 'react';
import {
  ClipboardCheck,
  AlertTriangle,
  Receipt,
  ReceiptText,
  ExternalLink,
  Eye,
  X,
  Search,
  CheckCircle2,
  Calendar,
  Tag,
  ArrowRight,
  TrendingUp,
  FileQuestion,
} from 'lucide-react';
import { useEscapeClose } from '@/lib/hooks/use-escape-close';
import type { Gasto } from '@/lib/types/gasto';
import DigitalInvoice from '../gastos/digital-invoice';

export type GastoJustificacion = {
  id: string;
  categoria: string;
  comercio: string;
  monto: number;
  moneda: string;
  tasa_cambio: number | null;
  monto_convertido: number | null;
  monto_efectivo: number;
  fecha_gasto: string;
  url_comprobante: string | null;
  concepto: string | null;
  estado: string;
  creado_en: string;

  // ── Sprint 2: Fiscal Tax Breakdown & Dual-Currency ──
  moneda_original?: string | null;
  origen_tasa?: string | null;
  base_imponible_ves?: number | null;
  iva_ves?: number | null;
  exento_ves?: number | null;
  igtf_ves?: number | null;
  monto_ves?: number | null;
  monto_usd?: number | null;
  rif_comercio?: string | null;
  numero_factura?: string | null;
  requiere_revision_fiscal?: boolean | null;
};

export type JustificacionItem = {
  id: string;
  empleado: string;
  proyecto: string;
  monto_otorgado: number;
  monto_gastado: number;
  moneda: string;
  gastos_count: number;
  fecha_aprobacion: string;
  gastos: GastoJustificacion[];
};

export default function JustificacionClient({ items }: { items: JustificacionItem[] }) {
  const [search, setSearch] = useState('');
  const [filtro, setFiltro] = useState<'TODOS' | 'COMPLETOS' | 'EN_PROGRESO' | 'SIN_COMPROBANTES'>('TODOS');
  
  // Modal de Detalle de Gastos
  const [selectedSolicitud, setSelectedSolicitud] = useState<JustificacionItem | null>(null);

  // Modal de Factura Digital (eReceipt) — uses the unified Gasto type
  const [selectedGastoInvoice, setSelectedGastoInvoice] = useState<Gasto | null>(null);

  // Escape key: invoice modal takes priority, then solicitud modal
  const handleCloseInvoice = useCallback(() => setSelectedGastoInvoice(null), []);
  const handleCloseSolicitud = useCallback(() => setSelectedSolicitud(null), []);

  useEscapeClose(handleCloseInvoice, selectedGastoInvoice !== null);
  useEscapeClose(handleCloseSolicitud, selectedGastoInvoice === null && selectedSolicitud !== null);

  // Mantener actualizado el viático seleccionado si la lista cambia
  useEffect(() => {
    if (selectedSolicitud) {
      const updated = items.find((i) => i.id === selectedSolicitud.id);
      if (updated) setSelectedSolicitud(updated);
    }
  }, [items, selectedSolicitud]);

  const completados = items.filter((j) => j.monto_gastado >= j.monto_otorgado && j.monto_otorgado > 0).length;
  const alertas = items.filter((j) => j.gastos_count === 0).length;
  const enProgreso = items.filter((j) => j.monto_gastado < j.monto_otorgado && j.gastos_count > 0).length;

  const filteredItems = items.filter((item) => {
    const matchesSearch =
      item.empleado.toLowerCase().includes(search.toLowerCase()) ||
      item.proyecto.toLowerCase().includes(search.toLowerCase()) ||
      item.id.toLowerCase().includes(search.toLowerCase());

    const isCompleto = item.monto_gastado >= item.monto_otorgado && item.monto_otorgado > 0;
    const isSinComprobantes = item.gastos_count === 0;
    const isEnProgreso = !isCompleto && !isSinComprobantes;

    if (!matchesSearch) return false;

    if (filtro === 'COMPLETOS') return isCompleto;
    if (filtro === 'EN_PROGRESO') return isEnProgreso;
    if (filtro === 'SIN_COMPROBANTES') return isSinComprobantes;
    return true;
  });

  return (
    <>
      <div className="page-header">
        <h1 className="page-title">
          <ClipboardCheck size={24} strokeWidth={2} />
          Progreso de Justificación
        </h1>
        <p className="page-subtitle">
          Monitoreo en tiempo real del avance de viáticos otorgados y comprobantes registrados vía WhatsApp.
        </p>
      </div>

      {/* KPI GRID */}
      <div className="kpi-grid">
        <div
          className="kpi-card"
          onClick={() => setFiltro('TODOS')}
          style={{ cursor: 'pointer', border: filtro === 'TODOS' ? '1px solid var(--rendy-primary)' : undefined }}
        >
          <div className="kpi-card-label">Viáticos Activos</div>
          <div className="kpi-card-value">{items.length}</div>
          <div className="kpi-card-delta up">En seguimiento</div>
        </div>
        <div
          className="kpi-card"
          onClick={() => setFiltro('COMPLETOS')}
          style={{ cursor: 'pointer', border: filtro === 'COMPLETOS' ? '1px solid var(--rendy-accent)' : undefined }}
        >
          <div className="kpi-card-label">100% Justificados</div>
          <div className="kpi-card-value" style={{ color: 'var(--rendy-accent)' }}>{completados}</div>
          <div className="kpi-card-delta up">Comprobados</div>
        </div>
        <div
          className="kpi-card"
          onClick={() => setFiltro('SIN_COMPROBANTES')}
          style={{ cursor: 'pointer', border: filtro === 'SIN_COMPROBANTES' ? '1px solid var(--rendy-warning)' : undefined }}
        >
          <div className="kpi-card-label">Sin Comprobantes</div>
          <div className="kpi-card-value" style={{ color: 'var(--rendy-warning)' }}>{alertas}</div>
          <div className="kpi-card-delta down">Requieren rendición</div>
        </div>
      </div>


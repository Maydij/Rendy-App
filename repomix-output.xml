/**
 * @name resetearSesion
 * @description Resets the phone number's session state to INICIO with null payload.
 */
export async function resetearSesion(
  supabase: SupabaseClient,
  telefono: string,
  empleadoId?: string | null
) {
  clearInactivityTimers(telefono);
  const payload: Record<string, unknown> = {
    telefono,
    empleado_id: empleadoId || null,
    estado: 'INICIO',
    datos_temporales: null,
    ultima_interaccion: new Date().toISOString(),
  };
  if (empleadoId) {
    payload.usuario_activo_id = empleadoId;
  }

  const { error } = await supabase.from('sesiones_whatsapp').upsert(payload);
  if (error && (error.message?.includes('usuario_activo_id') || error.code === '42703')) {
    delete payload.usuario_activo_id;
    await supabase.from('sesiones_whatsapp').upsert(payload);
  }
}

/**
 * @name actualizarSesion
 * @description Upserts the conversation state and temporary payload in Supabase.
 */
export async function actualizarSesion(
  supabase: SupabaseClient,
  telefono: string,
  estado: EstadoConversacion,
  datos: DatosTemporalesSesion | null,
  empleadoId?: string | null,
  employeeName?: string
) {
  if (estado === 'INICIO') {
    clearInactivityTimers(telefono);
  } else {
    scheduleInactivityTimers({
      supabase,
      telefono,
      empleadoId,
      employeeName,
    });
  }

  const payload: Record<string, unknown> = {
    telefono,
    empleado_id: empleadoId || null,
    estado,
    datos_temporales: datos as unknown as Record<string, unknown>,
    ultima_interaccion: new Date().toISOString(),
  };
  if (empleadoId) {
    payload.usuario_activo_id = empleadoId;
  }

  const { error } = await supabase.from('sesiones_whatsapp').upsert(payload);
  if (error && (error.message?.includes('usuario_activo_id') || error.code === '42703')) {
    delete payload.usuario_activo_id;
    await supabase.from('sesiones_whatsapp').upsert(payload);
  }
}

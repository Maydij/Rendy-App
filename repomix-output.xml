'use client';

import React, { useState, useCallback } from 'react';
import {
  AlertTriangle,
  ExternalLink,
  FileText,
  Image as ImageIcon,
  ShieldCheck,
  X,
} from 'lucide-react';
import { useEscapeClose } from '@/lib/hooks/use-escape-close';
import type { Gasto } from '@/lib/types/gasto';

/* ─────────────────────────────────────────────────────────────
   Props Interface
   ───────────────────────────────────────────────────────────── */

interface DigitalInvoiceProps {
  /** The expense record to render as a digital receipt. */
  gasto: Gasto;
  /** Callback to close the modal (sets parent state to null). */
  onClose: () => void;
}

/* ─────────────────────────────────────────────────────────────
   Component
   ───────────────────────────────────────────────────────────── */

/**
 * @name DigitalInvoice
 * @description [UI Component]: Full-screen modal that renders a stylised
 * e-Receipt (digital invoice) for any expense across the platform.
 * Accepts a single `Gasto` object so the receipt data is always
 * consistent regardless of which module triggers it (Gastos,
 * Reembolsos, or Justificación).
 *
 * Includes two tabs:
 * 1. **Factura Digital** — Paper-style receipt with OCR-verified data.
 * 2. **Foto Original** — Raw receipt image from Supabase Storage.
 */
const DigitalInvoice = ({ gasto, onClose }: DigitalInvoiceProps) => {
  const [activeTab, setActiveTab] = useState<'digital' | 'imagen'>('digital');

  const handleClose = useCallback(() => onClose(), [onClose]);

  useEscapeClose(handleClose);

  const imageUrl = gasto.url_comprobante ?? (gasto.datos_ocr as { url_comprobante?: string })?.url_comprobante ?? null;
  const hasExchangeRate = gasto.tasa_cambio != null && gasto.tasa_cambio !== 1;

  return (
    <div
      style={{
        position: 'fixed',
        inset: 0,
        background: 'rgba(5, 7, 15, 0.85)',
        backdropFilter: 'blur(10px)',
        display: 'flex',
        alignItems: 'center',
        justifyContent: 'center',
        zIndex: 200,
        padding: '16px',
        animation: 'fadeIn 0.2s ease',
      }}
      onClick={handleClose}
    >
      <div
        style={{
          background: 'var(--bg-surface)',
          border: '1px solid rgba(99, 102, 241, 0.25)',
          borderRadius: '20px',
          maxWidth: '560px',
          width: '100%',
          maxHeight: '92vh',
          display: 'flex',
          flexDirection: 'column',
          boxShadow:
            '0 30px 80px rgba(0, 0, 0, 0.9), 0 0 50px rgba(99, 102, 241, 0.15)',
          overflow: 'hidden',
        }}
        onClick={(e) => e.stopPropagation()}
      >
        {/* ── Header with Tab Selector ── */}
        <div
          style={{
            padding: '14px 20px',
            borderBottom: '1px solid var(--bg-border)',
            display: 'flex',
            alignItems: 'center',
            justifyContent: 'space-between',
            background: 'var(--bg-elevated)',
          }}
        >
          <div
            style={{
              display: 'flex',
              gap: '6px',
              background: 'var(--bg-surface)',
              padding: '4px',
              borderRadius: '10px',
              border: '1px solid var(--bg-border)',
            }}
          >
            <button
              type="button"
              onClick={() => setActiveTab('digital')}
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: '6px',
                padding: '6px 14px',
                borderRadius: '7px',
                border: 'none',
                fontSize: '12px',
                fontWeight: 700,
                cursor: 'pointer',
                background:
                  activeTab === 'digital'
                    ? 'var(--rendy-primary)'
                    : 'transparent',
                color:
                  activeTab === 'digital' ? 'white' : 'var(--text-muted)',
                transition: 'all 0.15s ease',
              }}
            >
              <FileText size={14} /> Factura Digital
            </button>
            <button
              type="button"
              onClick={() => setActiveTab('imagen')}
              disabled={!imageUrl}
              style={{
                display: 'flex',
                alignItems: 'center',
                gap: '6px',
                padding: '6px 14px',
                borderRadius: '7px',
                border: 'none',
                fontSize: '12px',
                fontWeight: 700,
                cursor: imageUrl ? 'pointer' : 'not-allowed',
                background:
                  activeTab === 'imagen'
                    ? 'var(--rendy-primary)'
                    : 'transparent',
                color:
                  activeTab === 'imagen'
                    ? 'white'
                    : imageUrl
                      ? 'var(--text-muted)'
                      : 'rgba(255,255,255,0.2)',
                transition: 'all 0.15s ease',
              }}
            >
              <ImageIcon size={14} /> Foto Original
            </button>
          </div>

          <div style={{ display: 'flex', alignItems: 'center', gap: '8px' }}>
            {imageUrl && (
              <a
                href={imageUrl}
                target="_blank"
                rel="noopener noreferrer"
                className="btn btn-ghost btn-sm"
                style={{ padding: '6px 10px', fontSize: '11px' }}
                title="Abrir imagen en pestaña nueva"
              >
                <ExternalLink size={12} />
              </a>
            )}
            <button
              type="button"
              onClick={handleClose}
              style={{
                background: 'transparent',
                border: 'none',
                color: 'var(--text-muted)',
                cursor: 'pointer',
                padding: '6px',
                borderRadius: '8px',
                display: 'flex',
                alignItems: 'center',
                justifyContent: 'center',
              }}
              aria-label="Cerrar modal"
            >
              <X size={20} />
            </button>
          </div>
        </div>

        {/* ── Dynamic Content Area ── */}
        <div
          style={{
            flex: 1,
            overflowY: 'auto',
            padding: '24px',
            background: '#0a0d16',
          }}
        >
          {activeTab === 'digital' ? (
            <ReceiptBody gasto={gasto} hasExchangeRate={hasExchangeRate} />
          ) : (
            <ReceiptImage imageUrl={imageUrl} comercio={gasto.comercio} />
          )}
        </div>

        {/* ── Footer ── */}
        <div
          style={{
            padding: '14px 20px',
            borderTop: '1px solid var(--bg-border)',

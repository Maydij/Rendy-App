                              id={`comprobante-${r.id}`}
                              className="btn btn-ghost btn-sm"
                              aria-label="Ver comprobante"
                            >
                              <Receipt size={13} />
                            </a>
                          )}
                        </div>
                      </td>
                    </tr>
                  );
                })}
              </tbody>
            </table>
          </div>
        )}
      </div>
    </>
  );
}
